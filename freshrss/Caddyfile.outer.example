# Edge Caddy — the hop the browser reaches, in a two-hop deployment.
#
# Pairs with Caddyfile.inner.example, which forwards to the FreshRSS container. If nothing sits in
# front of Caddy, you do not need two hops: point this file at `freshrss:80` directly and drop the
# inner one entirely.
#
# Replace `dukangxu.com`, `caddy-inner` and the fallback target with your own values.

dukangxu.com {
	# The FreshRSS sub-directory, reached through the inner Caddy. `handle`, not `handle_path`:
	# the request must arrive at FreshRSS as /rss/… with the prefix intact.
	handle /rss/* {
		reverse_proxy caddy-inner:80 {
			# This hop does know what the client used, so it sets the headers rather than
			# relaying them. The inner Caddy then passes them on untouched.
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Port {server_port}
		}
	}

	redir /rss /rss/ 308

	# Everything else on this domain is forwarded to the main site. The matcher is what keeps this
	# from swallowing /rss: Caddy's built-in directive order evaluates `redir` before `handle`, so a
	# catch-all redirect with no matcher would answer every request and /rss would never be proxied.
	@catchall not path /rss /rss/*
	redir @catchall https://www.example.com{uri}

	respond 404
}
