index 0000000..b65c340
--- /dev/null
+++ b/tests/lib/Minz/RequestTest.php
@@ -0,0 +1,243 @@
+<?php
+declare(strict_types=1);
+
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Multi-domain and sub-directory support.
+ *
+ * `base_url` may be a path (e.g. `/rss`) or empty, in which case the host is resolved from
+ * the current request so that one instance can be served through several domains. These
+ * tests pin the two invariants that makes this safe:
+ *
+ *  1. `applicationPath()` returns the *public root* of the instance, never the directory of
+ *     the current page, so that appending `PUBLIC_TO_INDEX_PATH` cannot produce `/i/i`;
+ *  2. `guessBaseUrl()` is stable across entry points (`p/`, `p/i/`, `p/api/`, `p/f.php`).
+ *
+ * @see \Minz_Request::applicationPath()
+ * @see \Minz_Request::guessBaseUrl()
+ */
+final class RequestTest extends TestCase {
+
+	private static string $configFile;
+	private static string $defaultFile;
+
+	#[\Override]
+	public static function setUpBeforeClass(): void {
+		$dir = sys_get_temp_dir() . '/freshrss-test-' . getmypid();
+		if (!is_dir($dir)) {
+			mkdir($dir, 0o777, true);
+		}
+		self::$configFile = $dir . '/config.php';
+		self::$defaultFile = $dir . '/config.default.php';
+		// Minimal stand-in for ./data/config.php and ./config.default.php
+		file_put_contents(self::$defaultFile, '<?php return ' . var_export([
+			'base_url' => '',
+			'websub_base_url' => '',
+			'allowed_hosts' => [],
+		], true) . ';');
+	}
+
+	#[\Override]
+	public static function tearDownAfterClass(): void {
+		foreach ([self::$configFile, self::$defaultFile] as $file) {
+			if (is_file($file)) {
+				unlink($file);
+			}
+		}
+		$dir = sys_get_temp_dir() . '/freshrss-test-' . getmypid();
+		if (is_dir($dir)) {
+			rmdir($dir);
+		}
+	}
+
+	/**
+	 * @param array<string,mixed> $system
+	 */
+	private static function useConfig(array $system): void {
+		file_put_contents(self::$configFile, '<?php return ' . var_export($system, true) . ';');
+		Minz_Configuration::register('system', self::$configFile, self::$defaultFile);
+	}
+
+	/**
+	 * @param array<string,string> $server
+	 */
+	private static function request(array $server): void {
+		$_SERVER = $server;
+	}
+
+	/**
+	 * Reverse proxy that forwards the public path unchanged (Apache `Alias` mode).
+	 *
+	 * @return array<string,string>
+	 */
+	private static function proxyKeepingPrefix(string $host, string $prefix = '/rss', string $script = '/i/index.php',
+		string $uri = '/i/?c=index&a=index'): array {
+		return [
+			'SCRIPT_NAME' => $prefix . $script,
+			'REQUEST_URI' => $prefix . $uri,
+			'HTTP_X_FORWARDED_HOST' => $host,
+			'HTTP_X_FORWARDED_PROTO' => 'https',
+			'HTTP_X_FORWARDED_PORT' => '443',
+		];
+	}
+
+	// -- applicationPath() -------------------------------------------------------------------
+
+	/**
+	 * @return array<string,array{0:string,1:string}>
+	 */
+	public static function provideScriptNames(): array {
+		return [
+			'root, web interface'  => ['/i/index.php', ''],
+			'root, landing'        => ['/index.php', ''],
+			'root, favicon'        => ['/f.php', ''],
+			'root, extension'      => ['/ext.php', ''],
+			'/rss, web interface'  => ['/rss/i/index.php', '/rss'],
+			'/rss, landing'        => ['/rss/index.php', '/rss'],
+			'/rss, favicon'        => ['/rss/f.php', '/rss'],
+			'/rss, extension'      => ['/rss/ext.php', '/rss'],
+			'/rss, WebSub'         => ['/rss/api/pshb.php', '/rss'],
+			'/rss, OIDC'           => ['/rss/i/oidc/index.php', '/rss'],
+			'nested prefix'        => ['/a/b/i/index.php', '/a/b'],
+		];
+	}
+
+	/**
+	 * @dataProvider provideScriptNames
+	 */
+	public static function testApplicationPathFromScriptName(string $scriptName, string $expected): void {
+		self::request(['SCRIPT_NAME' => $scriptName]);
+		self::assertSame($expected, Minz_Request::applicationPath());
+	}
+
+	public static function testApplicationPathPrefersForwardedPrefix(): void {
+		// Reverse proxy stripping the prefix (Caddy `handle_path` + X-Forwarded-Prefix)
+		self::request(['SCRIPT_NAME' => '/i/index.php', 'HTTP_X_FORWARDED_PREFIX' => '/rss']);
+		self::assertSame('/rss', Minz_Request::applicationPath());
+
+		self::request(['SCRIPT_NAME' => '/i/index.php', 'HTTP_X_FORWARDED_PREFIX' => '/rss/']);
+		self::assertSame('/rss', Minz_Request::applicationPath());
+	}
+
+	public static function testApplicationPathWithoutAnyPrefix(): void {
+		self::request(['SCRIPT_NAME' => '/i/index.php']);
+		self::assertSame('', Minz_Request::applicationPath());
+	}
+
+	// -- guessBaseUrl() ---------------------------------------------------------------------
+
+	public static function testGuessBaseUrlFollowsTheRequestHost(): void {
+		self::useConfig(['base_url' => '/rss']);
+		foreach (['a.example', 'b.example', 'cn.example.org'] as $host) {
+			self::request(self::proxyKeepingPrefix($host));
+			self::assertSame("https://$host/rss", Minz_Request::guessBaseUrl());
+		}
+	}
+
+	/**
+	 * @return array<string,array{0:string,1:string,2:string}>
+	 */
+	public static function provideEntryPoints(): array {
+		// Paths are relative to the public prefix, i.e. to `p/`.
+		return [
+			'landing'   => ['/index.php', '/', 'https://a.example/rss'],
+			'web UI'    => ['/i/index.php', '/i/?c=index&a=index', 'https://a.example/rss'],
+			'WebSub'    => ['/api/pshb.php', '/api/pshb.php?k=abc', 'https://a.example/rss'],
+			'favicon'   => ['/f.php', '/f.php?h=deadbeef', 'https://a.example/rss'],
+			'extension' => ['/ext.php', '/ext.php?f=x.css', 'https://a.example/rss'],
+		];
+	}
+
+	/**
+	 * The public root must be the same for every entry point, and appending
+	 * PUBLIC_TO_INDEX_PATH must never produce a duplicated `/i`.
+	 *
+	 * @dataProvider provideEntryPoints
+	 */
+	public static function testGuessBaseUrlIsStableAcrossEntryPoints(string $script, string $uri, string $expected): void {
+		self::useConfig(['base_url' => '/rss']);
+		self::request(self::proxyKeepingPrefix('a.example', '/rss', $script, $uri));
+		self::assertSame($expected, Minz_Request::guessBaseUrl());
+
+		$built = Minz_Request::guessBaseUrl() . PUBLIC_TO_INDEX_PATH;
+		self::assertSame('/rss/i', parse_url($built, PHP_URL_PATH));
+		self::assertStringNotContainsString('/i/i', $built);
+	}
+
+	public static function testGuessBaseUrlIsIdenticalOnEveryDomain(): void {
+		self::useConfig(['base_url' => '/rss']);
+		$paths = [];
+		$entryPoints = self::provideEntryPoints();
+		foreach (['a.example', 'b.example'] as $host) {
+			foreach ($entryPoints as [$script, $uri]) {
+				self::request(self::proxyKeepingPrefix($host, '/rss', $script, $uri));
+				$paths[] = (string)parse_url(Minz_Request::guessBaseUrl(), PHP_URL_PATH);
+			}
+		}
+		self::assertSame(['/rss'], array_values(array_unique($paths)));
+	}
+
+	// -- getBaseUrl() / canonicalBaseUrl() ---------------------------------------------------
+
+	public static function testFullUrlBaseUrlIsPinned(): void {
+		self::useConfig(['base_url' => 'https://pinned.example.net/rss']);
+		self::request(self::proxyKeepingPrefix('a.example'));
+		self::assertSame('https://pinned.example.net/rss', Minz_Request::getBaseUrl());
+		self::assertSame('https://pinned.example.net/rss', Minz_Request::canonicalBaseUrl());
+	}
+
+	public static function testPathOnlyBaseUrlIsNotAnAbsoluteUrl(): void {
+		self::useConfig(['base_url' => '/rss']);
+		self::request(self::proxyKeepingPrefix('a.example'));
+		// Empty, so that Minz_Url::display() falls back to the request.
+		self::assertSame('', Minz_Request::getBaseUrl());
+	}
+
+	public static function testWebSubBaseUrlIsPinnedOnEveryDomain(): void {
+		self::useConfig(['base_url' => '/rss', 'websub_base_url' => 'https://rss.example.net/rss']);
+		foreach (['a.example', 'b.example', 'cn.example.org'] as $host) {
+			self::request(self::proxyKeepingPrefix($host));
+			self::assertSame('https://rss.example.net/rss/api/pshb.php?k=abc',
+				Minz_Request::canonicalBaseUrl() . '/api/pshb.php?k=abc');
+			self::assertTrue(Minz_Request::serverIsPublic(Minz_Request::canonicalBaseUrl()));
+		}
+	}
+
+	public static function testWebSubStaysDisabledWithoutAnAbsoluteUrl(): void {
+		self::useConfig(['base_url' => '/rss', 'websub_base_url' => '']);
+		self::request(self::proxyKeepingPrefix('a.example'));
+		// The refresh cron job runs under the CLI SAPI, with no request to guess a host from:
+		// advertising a wrong callback is worse than advertising none.
+		self::assertSame('', Minz_Request::canonicalBaseUrl());
+		self::assertFalse(Minz_Request::serverIsPublic(Minz_Request::canonicalBaseUrl()));
+		self::assertFalse(Minz_Request::serverIsPublic('/rss'));
+	}
+
+	// -- allowed_hosts -----------------------------------------------------------------------
+
+	public static function testAllowedHostsKeepsKnownHosts(): void {
+		self::useConfig(['base_url' => '/rss', 'allowed_hosts' => ['a.example', 'b.example']]);
+		self::request(self::proxyKeepingPrefix('a.example'));
+		self::assertSame('https://a.example/rss', Minz_Request::guessBaseUrl());
+		self::request(self::proxyKeepingPrefix('b.example'));
+		self::assertSame('https://b.example/rss', Minz_Request::guessBaseUrl());
+	}
+
+	public static function testAllowedHostsNeutralisesHostHeaderInjection(): void {
+		self::useConfig(['base_url' => '/rss', 'allowed_hosts' => ['a.example', 'b.example']]);
+		self::request(self::proxyKeepingPrefix('evil.example'));
+		self::assertSame('https://a.example/rss', Minz_Request::guessBaseUrl());
+	}
+
+	public static function testEmptyAllowedHostsAcceptsAnyHost(): void {
+		self::useConfig(['base_url' => '/rss', 'allowed_hosts' => []]);
+		self::request(self::proxyKeepingPrefix('whatever.example'));
+		self::assertSame('https://whatever.example/rss', Minz_Request::guessBaseUrl());
+	}
+
+	#[\Override]
+	protected function tearDown(): void {
+		$_SERVER = [];
+	}
+}
