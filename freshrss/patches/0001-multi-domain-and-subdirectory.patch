+ * `Minz_Url::display()` used to apply a heuristic — when it had to guess the base URL it removed a
+ * trailing `/i` with `dirname()` — which was compensating for `guessBaseUrl()` returning the
+ * directory of the *current page*. Now that `guessBaseUrl()` returns the public root, that
+ * heuristic had to go: on an instance served from `/i` (a legitimate sub-directory name) it
+ * truncated the prefix to the domain root.
+ *
+ * The three modes therefore have to be pinned down:
+ *  - relative (the default, 102 of 117 call sites): no host, no prefix guessing;
+ *  - `'root'`: absolute, but reduced to the *path*;
+ *  - `true`: fully absolute.
+ *
+ * @see \Minz_Request::applicationPath()
+ */
+final class UrlTest extends TestCase {
+
+	private static string $configFile;
+	private static string $defaultFile;
+
+	#[\Override]
+	public static function setUpBeforeClass(): void {
+		$dir = sys_get_temp_dir() . '/freshrss-urltest-' . getmypid();
+		if (!is_dir($dir)) {
+			mkdir($dir, 0o777, true);
+		}
+		self::$configFile = $dir . '/config.php';
+		self::$defaultFile = $dir . '/config.default.php';
+		file_put_contents(self::$defaultFile, '<?php return ' . var_export([
+			'base_url' => '',
+			'websub_base_url' => '',
+			'allowed_hosts' => [],
+		], true) . ';');
+	}
+
+	#[Override]
+	public static function tearDownAfterClass(): void {
+		foreach ([self::$configFile, self::$defaultFile] as $file) {
+			if (is_file($file)) {
+				unlink($file);
+			}
+		}
+		$dir = sys_get_temp_dir() . '/freshrss-urltest-' . getmypid();
+		if (is_dir($dir)) {
+			rmdir($dir);
+		}
+	}
+
+	/**
+	 * @param array<string,mixed> $config
+	 * @param array<string,string> $server
+	 */
+	private static function given(array $config, array $server): void {
+		file_put_contents(self::$configFile, '<?php return ' . var_export($config, true) . ';');
+		Minz_Configuration::register('system', self::$configFile, self::$defaultFile);
+		$_SERVER = $server;
+	}
+
+	/**
+	 * @return array<string,string>
+	 */
+	private static function subDirectoryRequest(string $host = 'a.example', string $prefix = '/rss'): array {
+		return [
+			'SCRIPT_NAME' => $prefix . '/i/index.php',
+			'REQUEST_URI' => $prefix . '/i/',
+			'HTTP_X_FORWARDED_HOST' => $host,
+			'HTTP_X_FORWARDED_PROTO' => 'https',
+		];
+	}
+
+	// -- relative mode (the default) --------------------------------------------------------
+
+	public static function testRelativeModeHasNoHostAndNoPathGuess(): void {
+		self::given(['base_url' => '/rss'], self::subDirectoryRequest());
+		// Array form: a controller link, resolved against the current page.
+		self::assertSame('./', Minz_Url::display(['c' => 'index', 'a' => 'index']));
+		// String form: an asset, resolved against `p/`.
+		self::assertSame('../scripts/main.js', Minz_Url::display('/scripts/main.js'));
+		self::assertSame('../themes/icons/favicon.svg', Minz_Url::display('/themes/icons/favicon.svg'));
+	}
+
+	public static function testRelativeModeIsUnaffectedByTheBaseUrl(): void {
+		foreach (['/rss', '', 'https://pinned.example/rss'] as $baseUrl) {
+			self::given(['base_url' => $baseUrl], self::subDirectoryRequest());
+			self::assertSame('./', Minz_Url::display(['c' => 'index', 'a' => 'index']),
+				"base_url={$baseUrl}");
+		}
+	}
+
+	// -- 'root' mode: absolute, reduced to the path -------------------------------------------
+
+	public static function testRootModeYieldsThePathOnly(): void {
+		self::given(['base_url' => '/rss'], self::subDirectoryRequest());
+		self::assertSame('/rss/i/', Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', 'root'));
+	}
+
+	public static function testRootModeFollowsTheHostWithoutEmittingIt(): void {
+		self::given(['base_url' => '/rss'], self::subDirectoryRequest('b.example'));
+		$url = Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', 'root');
+		self::assertSame('/rss/i/', $url);
+		self::assertStringNotContainsString('b.example', $url);
+	}
+
+	/**
+	 * The removed heuristic truncated any base URL ending in `/i` to the domain root, so an
+	 * instance served from a sub-directory named `/i` sent every link to `/i/` instead of `/i/i/`.
+	 * `SCRIPT_NAME` alone cannot tell that case from the `/i/` entry-point, which is why the
+	 * deployment states the prefix explicitly — the same value the container hands to Apache.
+	 */
+	public static function testRootModeKeepsAPrefixThatIsItselfNamedI(): void {
+		putenv('FRESHRSS_PATH_PREFIX=/i');
+		try {
+			self::given(['base_url' => '/i'], [
+				'SCRIPT_NAME' => '/i/i/index.php',
+				'REQUEST_URI' => '/i/i/?c=index&a=index',
+				'HTTP_X_FORWARDED_HOST' => 'a.example',
+				'HTTP_X_FORWARDED_PROTO' => 'https',
+			]);
+			self::assertSame('/i', Minz_Request::applicationPath());
+			self::assertSame('/i/i/',
+				Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', 'root'));
+			self::assertSame('https://a.example/i/i/',
+				Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', true));
+		} finally {
+			putenv('FRESHRSS_PATH_PREFIX');
+		}
+	}
+
+	public static function testConfiguredPrefixWinsOverTheForwardedHeader(): void {
+		// A stripping proxy advertises the prefix a second time; the configured value is what
+		// Apache was set up with, and it must not be double-applied.
+		putenv('FRESHRSS_PATH_PREFIX=/rss/');
+		try {
+			self::given(['base_url' => '/rss'], [
+				'SCRIPT_NAME' => '/i/index.php',
+				'REQUEST_URI' => '/i/?c=index&a=index',
+				'HTTP_X_FORWARDED_HOST' => 'a.example',
+				'HTTP_X_FORWARDED_PROTO' => 'https',
+				'HTTP_X_FORWARDED_PREFIX' => '/rss',
+			]);
+			self::assertSame('/rss', Minz_Request::applicationPath());
+			self::assertSame('https://a.example/rss/i/',
+				Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', true));
+		} finally {
+			putenv('FRESHRSS_PATH_PREFIX');
+		}
+	}
+
+	public static function testConfiguredRootPrefixMeansNoSubDirectory(): void {
+		putenv('FRESHRSS_PATH_PREFIX=/');
+		try {
+			self::given(['base_url' => ''], [
+				'SCRIPT_NAME' => '/i/index.php',
+				'REQUEST_URI' => '/i/?c=index&a=index',
+				'HTTP_X_FORWARDED_HOST' => 'a.example',
+				'HTTP_X_FORWARDED_PROTO' => 'https',
+			]);
+			self::assertSame('', Minz_Request::applicationPath());
+			self::assertSame('https://a.example/i/',
+				Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', true));
+		} finally {
+			putenv('FRESHRSS_PATH_PREFIX');
+		}
+	}
+
+	public static function testRootModeAtTheDomainRootHasNoLeadingSlashProblem(): void {
+		self::given(['base_url' => ''], [
+			'SCRIPT_NAME' => '/i/index.php',
+			'REQUEST_URI' => '/i/',
+			'HTTP_X_FORWARDED_HOST' => 'a.example',
+			'HTTP_X_FORWARDED_PROTO' => 'https',
+		]);
+		self::assertSame('/i/', Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', 'root'));
+	}
+
+	public static function testRootModeWithAPinnedBaseUrl(): void {
+		self::given(['base_url' => 'https://pinned.example/rss'], self::subDirectoryRequest('b.example'));
+		// A full base URL pins the host, even though the request came in on another domain.
+		self::assertSame('/rss/i/',
+			Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', 'root'));
+	}
+
+	// -- absolute mode ------------------------------------------------------------------------
+
+	public static function testAbsoluteModeFollowsTheRequestHost(): void {
+		self::given(['base_url' => '/rss'], self::subDirectoryRequest('a.example'));
+		self::assertSame('https://a.example/rss/i/',
+			Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', true));
+		self::given(['base_url' => '/rss'], self::subDirectoryRequest('cn.example.org'));
+		self::assertSame('https://cn.example.org/rss/i/',
+			Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', true));
+	}
+
+	public static function testAbsoluteModeOnAStaticPath(): void {
+		self::given(['base_url' => '/rss'], self::subDirectoryRequest());
+		// This is what a mobile client is handed in the API page.
+		self::assertSame('https://a.example/rss/api/greader.php', Minz_Url::display('/api/greader.php', 'html', true));
+	}
+
+	public static function testAbsoluteModeHonoursAPinnedBaseUrl(): void {
+		self::given(['base_url' => 'https://pinned.example/rss'], self::subDirectoryRequest('b.example'));
+		self::assertSame('https://pinned.example/rss/api/greader.php',
+			Minz_Url::display('/api/greader.php', 'html', true));
+	}
+
+	// -- reverse proxy stripping the prefix --------------------------------------------------
+
+	public static function testAbsoluteModeWithAStrippingProxy(): void {
+		self::given(['base_url' => '/rss'], [
+			'SCRIPT_NAME' => '/i/index.php',
+			'REQUEST_URI' => '/i/',
+			'HTTP_X_FORWARDED_HOST' => 'a.example',
+			'HTTP_X_FORWARDED_PROTO' => 'https',
+			'HTTP_X_FORWARDED_PREFIX' => '/rss',
+		]);
+		self::assertSame('https://a.example/rss/i/',
+			Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', true));
+		self::assertSame('https://a.example/rss/api/greader.php',
+			Minz_Url::display('/api/greader.php', 'html', true));
+	}
+
+	// -- encoding -----------------------------------------------------------------------------
+
+	public static function testHtmlEncodingUsesAmpersandEntity(): void {
+		self::given(['base_url' => '/rss'], self::subDirectoryRequest());
+		$url = Minz_Url::display(
+			['c' => 'index', 'a' => 'normal', 'params' => ['search' => 'a b', 'state' => 2]],
+			'html',
+			'root'
+		);
+		self::assertSame('/rss/i/?a=normal&amp;search=a+b&amp;state=2', $url);
+
+		// A non-default controller is part of the query string.
+		self::assertSame('/rss/i/?c=configure&amp;a=system',
+			Minz_Url::display(['c' => 'configure', 'a' => 'system'], 'html', 'root'));
+	}
+
+	#[Override]
+	protected function tearDown(): void {
+		$_SERVER = [];
+		putenv('FRESHRSS_PATH_PREFIX');
+	}
+}
