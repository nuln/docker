+<?php
+declare(strict_types=1);
+
+use PHPUnit\Framework\TestCase;
+
+/**
+ * The ID-token verifier is the security boundary of the OIDC login: everything else is plumbing.
+ *
+ * These tests build real RSA keys and sign real tokens, so they exercise the actual signature path
+ * (JWK → PEM → openssl_verify) rather than a mock of it. Each rejection case asserts one specific
+ * defence, because a verifier that merely "returns false sometimes" is not a verifier.
+ */
+final class OidcTest extends TestCase {
+
+	private static string $privateKey;
+	/** @var array<string,mixed> */
+	private static array $jwks;
+	private static string $issuer = 'https://idp.example';
+	private static string $clientId = 'freshrss';
+
+	/** @var array<string,mixed> */
+	private array $metadata;
+
+	#[\Override]
+	protected function setUp(): void {
+		if (!isset(self::$privateKey)) {
+			$key = openssl_pkey_new(['private_key_bits' => 2048, 'private_key_type' => OPENSSL_KEYTYPE_RSA]);
+			self::assertNotFalse($key);
+			openssl_pkey_export($key, $privateKeyPem);
+			self::assertIsString($privateKeyPem);
+			self::$privateKey = $privateKeyPem;
+			$details = openssl_pkey_get_details($key);
+			self::assertIsArray($details);
+			$rsa = $details['rsa'] ?? null;
+			self::assertIsArray($rsa);
+			self::$jwks = ['keys' => [[
+				'kty' => 'RSA',
+				'kid' => 'key-1',
+				'use' => 'sig',
+				'alg' => 'RS256',
+				'n' => self::base64Url(self::stringPart($rsa, 'n')),
+				'e' => self::base64Url(self::stringPart($rsa, 'e')),
+			]]];
+		}
+		$this->metadata = ['issuer' => self::$issuer];
+	}
+
+	/** @param array<mixed> $rsa */
+	private static function stringPart(array $rsa, string $key): string {
+		$value = $rsa[$key] ?? null;
+		self::assertIsString($value);
+		return $value;
+	}
+
+	private static function base64Url(string $value): string {
+		return rtrim(strtr(base64_encode($value), '+/', '-_'), '=');
+	}
+
+	/**
+	 * @param array<string,mixed> $claims
+	 */
+	private function sign(array $claims, string $alg = 'RS256', string $kid = 'key-1', ?string $key = null): string {
+		$header = ['alg' => $alg, 'typ' => 'JWT'];
+		if ($kid !== '') {
+			$header['kid'] = $kid;
+		}
+		$signingInput = self::base64Url(json_encode($header, JSON_UNESCAPED_SLASHES) ?: '{}')
+			. '.' . self::base64Url(json_encode($claims, JSON_UNESCAPED_SLASHES) ?: '{}');
+
+		if ($alg === 'none') {
+			return $signingInput . '.';
+		}
+		$signature = '';
+		openssl_sign($signingInput, $signature, $key ?? self::$privateKey, OPENSSL_ALGO_SHA256);
+		self::assertIsString($signature);
+		return $signingInput . '.' . self::base64Url($signature);
+	}
+
+	/**
+	 * @param array<string,mixed> $overrides
+	 * @return array<string,mixed>
+	 */
+	private function claims(array $overrides = []): array {
+		return array_merge([
+			'iss' => self::$issuer,
+			'aud' => self::$clientId,
+			'sub' => 'abc123',
+			'exp' => time() + 300,
+			'iat' => time(),
+			'nonce' => 'expected-nonce',
+			'preferred_username' => 'alice',
+		], $overrides);
+	}
+
+	/**
+	 * @param array<string,mixed> $claims
+	 * @param array<string,mixed>|null $jwks
+	 * @return array<string,mixed>
+	 */
+	private function verify(array $claims, string $nonce = 'expected-nonce', ?array $jwks = null): array {
+		return FreshRSS_Oidc::verifyToken($this->sign($claims), $this->metadata, $jwks ?? self::$jwks,
+			self::$clientId, $nonce);
+	}
+
+	public function testAcceptsAValidTokenAndReturnsItsClaims(): void {
+		$claims = $this->verify($this->claims());
+		self::assertSame('alice', $claims['preferred_username']);
+		self::assertSame('abc123', $claims['sub']);
+	}
+
+	public function testRejectsATamperedPayload(): void {
+		$token = $this->sign($this->claims());
+		[$header, , $signature] = explode('.', $token);
+		$forged = self::base64Url(json_encode($this->claims(['preferred_username' => 'admin'])) ?: '{}');
+		$this->expectException(Minz_Exception::class);
+		FreshRSS_Oidc::verifyToken($header . '.' . $forged . '.' . $signature, $this->metadata, self::$jwks,
+			self::$clientId, 'expected-nonce');
+	}
+
+	public function testRejectsAlgNone(): void {
+		$this->expectException(Minz_Exception::class);
+		$this->expectExceptionMessage('algorithm');
+		FreshRSS_Oidc::verifyToken($this->sign($this->claims(), 'none'), $this->metadata, self::$jwks,
+			self::$clientId, 'expected-nonce');
+	}
+
+	/** The classic confusion attack: sign with a symmetric algorithm the verifier might treat as RSA. */
+	public function testRejectsSymmetricAlgorithm(): void {
+		$this->expectException(Minz_Exception::class);
+		$this->expectExceptionMessage('algorithm');
+		FreshRSS_Oidc::verifyToken($this->sign($this->claims(), 'HS256'), $this->metadata, self::$jwks,
+			self::$clientId, 'expected-nonce');
+	}
+
+	public function testRejectsAWrongIssuer(): void {
+		$this->expectException(Minz_Exception::class);
+		$this->expectExceptionMessage('issuer');
+		$this->verify($this->claims(['iss' => 'https://evil.example']));
+	}
+
+	public function testRejectsAWrongAudience(): void {
+		$this->expectException(Minz_Exception::class);
+		$this->expectExceptionMessage('audience');
+		$this->verify($this->claims(['aud' => 'another-client']));
+	}
+
+	public function testAcceptsAnAudienceListContainingThisClient(): void {
+		$claims = $this->verify($this->claims(['aud' => ['another-client', self::$clientId]]));
+		self::assertSame('alice', $claims['preferred_username']);
+	}
+
+	public function testRejectsAnExpiredToken(): void {
+		$this->expectException(Minz_Exception::class);
+		$this->expectExceptionMessage('expired');
+		$this->verify($this->claims(['exp' => time() - 3600]));
+	}
+
+	public function testRejectsATokenFromTheFuture(): void {
+		$this->expectException(Minz_Exception::class);
+		$this->expectExceptionMessage('future');
+		$this->verify($this->claims(['iat' => time() + 3600]));
+	}
+
+	/** The nonce is what binds a token to the login attempt that started it. */
+	public function testRejectsAMismatchedNonce(): void {
+		$this->expectException(Minz_Exception::class);
+		$this->expectExceptionMessage('nonce');
+		$this->verify($this->claims(['nonce' => 'some-other-nonce']));
+	}
+
+	public function testRejectsAnUnknownKeyId(): void {
+		$this->expectException(Minz_Exception::class);
+		$this->expectExceptionMessage('signing key');
+		FreshRSS_Oidc::verifyToken($this->sign($this->claims(), kid: 'not-published'), $this->metadata,
+			self::$jwks, self::$clientId, 'expected-nonce');
+	}
+
+	public function testSelectsTheRightKeyAmongSeveral(): void {
+		$otherKey = openssl_pkey_new(['private_key_bits' => 2048, 'private_key_type' => OPENSSL_KEYTYPE_RSA]);
+		self::assertNotFalse($otherKey);
+		$details = openssl_pkey_get_details($otherKey);
+		self::assertIsArray($details);
+		$otherRsa = $details['rsa'] ?? null;
+		self::assertIsArray($otherRsa);
+		$keys = self::$jwks['keys'] ?? null;
+		self::assertIsArray($keys);
+		$keys[] = [
+			'kty' => 'RSA',
+			'kid' => 'key-2',
+			'use' => 'sig',
+			'alg' => 'RS256',
+			'n' => self::base64Url(self::stringPart($otherRsa, 'n')),
+			'e' => self::base64Url(self::stringPart($otherRsa, 'e')),
+		];
+		$jwks = self::$jwks;
