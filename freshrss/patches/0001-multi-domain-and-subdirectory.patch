new file mode 100644
index 000000000..bf2956b7c
--- /dev/null
+++ b/app/Models/Oidc.php
@@ -0,0 +1,817 @@
+<?php
+declare(strict_types=1);
+
+/**
+ * OpenID Connect relying party, implemented in PHP so that no Apache module is needed.
+ *
+ * Only the *authorization code* flow with PKCE is implemented, and only RS256-signed ID tokens are
+ * accepted. Both restrictions are deliberate: they are what essentially every identity provider
+ * supports, and a narrow verifier is far easier to get right than a general JOSE library.
+ *
+ * Nothing here trusts the browser for identity: the code is exchanged server-side over the back
+ * channel, and the ID token signature is verified against the provider's JWKS before any claim is
+ * read.
+ *
+ * Configuration is read from the environment first, then from `data/config.php`, so a container can
+ * be configured without writing to its data volume. The variable names match the ones this image
+ * used with mod_auth_openidc, which keeps existing deployments a drop-in change:
+ *
+ *   OIDC_PROVIDER_METADATA_URL / OIDC_ISSUER   discovery document (or issuer, from which it is built)
+ *   OIDC_CLIENT_ID, OIDC_CLIENT_SECRET          client credentials
+ *   OIDC_SCOPES                                 default `openid profile email`
+ *   OIDC_REMOTE_USER_CLAIM                      claim holding the username (default `preferred_username`)
+ *   OIDC_AUTO_REGISTER                          create the FreshRSS user on first login (default on)
+ *   OIDC_ALLOW_INSECURE                         allow http:// for the provider — tests and local dev only
+ *   OIDC_LOGOUT_REDIRECT                        also end the session at the provider on logout
+ */
+final class FreshRSS_Oidc {
+
+	public const AUTH_TYPE = 'oidc';
+
+	/** Discovery document and JWKS are cached so a login does not depend on two extra round trips. */
+	private const METADATA_TTL = 3600;
+	private const JWKS_TTL = 21600;
+	/** Tolerated clock difference between this host and the provider, in seconds. */
+	private const CLOCK_SKEW = 120;
+	private const HTTP_TIMEOUT = 10;
+
+	// ---------------------------------------------------------------------------------------
+	// Configuration
+	// ---------------------------------------------------------------------------------------
+
+	/**
+	 * Resolve the effective configuration: environment first, then `data/config.php`.
+	 *
+	 * @return array{metadata_url:string,client_id:string,client_secret:string,scopes:string,
+	 *               claim:string,auto_register:bool,allow_insecure:bool,logout_redirect:bool}
+	 */
+	public static function config(): array {
+		return self::providerForHost(self::currentHost());
+	}
+
+	/**
+	 * The provider to use for a given host.
+	 *
+	 * One instance can serve several domains, and each domain may sit behind its **own** identity
+	 * provider. `OIDC_PROVIDERS` (JSON) or `oidc_providers` in `data/config.php` maps a host to
+	 * provider settings; anything not listed falls back to the top-level `OIDC_*` values, so a
+	 * single-provider deployment needs no map at all.
+	 *
+	 * @return array{metadata_url:string,client_id:string,client_secret:string,scopes:string,
+	 *               claim:string,username_map:array<string,string>,auto_register:bool,
+	 *               allow_insecure:bool,logout_redirect:bool}
+	 */
+	public static function providerForHost(string $host): array {
+		return self::selectProvider(self::defaultProvider(), self::providerOverrides(), $host);
+	}
+
+	/**
+	 * Merge the settings of one host over the defaults.
+	 *
+	 * Pure and static so the selection can be tested without a request or a configuration file.
+	 * Only a host that is present in the map can change the provider: the `Host` header never
+	 * becomes a URL by itself, so a forged header can at most select a provider the administrator
+	 * already configured.
+	 *
+	 * @param array{metadata_url:string,client_id:string,client_secret:string,scopes:string,
+	 *              claim:string,username_map:array<string,string>,auto_register:bool,
+	 *              allow_insecure:bool,logout_redirect:bool} $default
+	 * @param array<string,array<string,mixed>> $overrides host, or `*`, to partial provider settings
+	 * @return array{metadata_url:string,client_id:string,client_secret:string,scopes:string,
+	 *               claim:string,username_map:array<string,string>,auto_register:bool,
+	 *               allow_insecure:bool,logout_redirect:bool}
+	 */
+	public static function selectProvider(array $default, array $overrides, string $host): array {
+		$host = strtolower(trim($host));
+		// A Host header may carry a port; the map is keyed by name only.
+		if (str_contains($host, ':') && !str_starts_with($host, '[')) {
+			$host = substr($host, 0, (int)strrpos($host, ':'));
+		}
+		$entry = [];
+		if (isset($overrides[$host]) && is_array($overrides[$host])) {
+			$entry = $overrides[$host];
+		} elseif (isset($overrides['*']) && is_array($overrides['*'])) {
+			$entry = $overrides['*'];
+		}
+
+		$provider = $default;
+		// `issuer` is a shorthand for the discovery URL; an explicit metadata_url still wins.
+		$issuer = is_string($entry['issuer'] ?? null) ? $entry['issuer'] : '';
+		if ($issuer !== '') {
+			$provider['metadata_url'] = rtrim($issuer, '/') . '/.well-known/openid-configuration';
+		}
+		foreach (['metadata_url', 'client_id', 'client_secret', 'scopes', 'claim'] as $key) {
+			$value = $entry[$key] ?? null;
+			if (is_string($value) && $value !== '') {
+				$provider[$key] = $value;
+			}
+		}
+		$map = $entry['username_map'] ?? null;
+		if (is_array($map)) {
+			$clean = [];
+			foreach ($map as $from => $to) {
+				if (is_string($from) && $from !== '' && is_string($to) && $to !== '') {
+					$clean[$from] = $to;
+				}
+			}
+			$provider['username_map'] = $clean;
+		}
+		foreach (['auto_register', 'allow_insecure', 'logout_redirect'] as $key) {
+			if (isset($entry[$key])) {
+				$provider[$key] = (bool)$entry[$key];
+			}
+		}
+		return $provider;
+	}
+
+	/**
+	 * The top-level provider, used for any host without an entry of its own.
+	 *
+	 * @return array{metadata_url:string,client_id:string,client_secret:string,scopes:string,
+	 *               claim:string,username_map:array<string,string>,auto_register:bool,
+	 *               allow_insecure:bool,logout_redirect:bool}
+	 */
+	private static function defaultProvider(): array {
+		$conf = FreshRSS_Context::systemConf();
+
+		$metadataUrl = self::env('OIDC_PROVIDER_METADATA_URL') ?? $conf->oidc_metadata_url;
+		$issuer = self::env('OIDC_ISSUER') ?? $conf->oidc_issuer;
+		if ($metadataUrl === '' && $issuer !== '') {
+			$metadataUrl = rtrim($issuer, '/') . '/.well-known/openid-configuration';
+		}
+
+		$scopes = self::env('OIDC_SCOPES') ?? $conf->oidc_scopes;
+		if ($scopes === '') {
+			$scopes = 'openid profile email';
+		}
+
+		$claim = self::env('OIDC_REMOTE_USER_CLAIM') ?? $conf->oidc_remote_user_claim;
+		if ($claim === '') {
+			$claim = 'preferred_username';
+		}
+
+		$usernameMap = [];
+		$rawMap = self::env('OIDC_USERNAME_MAP');
+		if ($rawMap !== null) {
+			$decodedMap = json_decode($rawMap, true);
+			if (is_array($decodedMap)) {
+				foreach ($decodedMap as $from => $to) {
+					if (is_string($from) && $from !== '' && is_string($to) && $to !== '') {
+						$usernameMap[$from] = $to;
+					}
+				}
+			} else {
+				Minz_Log::warning('OIDC_USERNAME_MAP is not valid JSON; ignored');
+			}
+		} else {
+			$fromConf = $conf->oidc_username_map;
+			if (is_array($fromConf)) {
+				foreach ($fromConf as $from => $to) {
+					if (is_string($from) && $from !== '' && is_string($to) && $to !== '') {
+						$usernameMap[$from] = $to;
+					}
+				}
+			}
+		}
+
+		$autoRegister = self::env('OIDC_AUTO_REGISTER');
+		$allowInsecure = self::env('OIDC_ALLOW_INSECURE');
+		$logoutRedirect = self::env('OIDC_LOGOUT_REDIRECT');
+
+		return [
+			'metadata_url' => $metadataUrl,
+			'client_id' => self::env('OIDC_CLIENT_ID') ?? $conf->oidc_client_id,
+			'client_secret' => self::env('OIDC_CLIENT_SECRET') ?? $conf->oidc_client_secret,
+			'scopes' => $scopes,
+			'claim' => $claim,
+			'username_map' => $usernameMap,
+			'auto_register' => $autoRegister === null ? $conf->oidc_auto_register : $autoRegister !== '0',
+			'allow_insecure' => $allowInsecure === null ? $conf->oidc_allow_insecure : $allowInsecure !== '0',
+			'logout_redirect' => $logoutRedirect === null ? $conf->oidc_logout_redirect : $logoutRedirect !== '0',
+		];
+	}
+
+	/**
+	 * Per-host provider overrides.
+	 *
+	 * @return array<string,array<string,mixed>>
+	 */
+	private static function providerOverrides(): array {
+		$raw = self::env('OIDC_PROVIDERS');
+		if ($raw !== null) {
+			$decoded = json_decode($raw, true);
+			if (is_array($decoded)) {
+				/** @var array<string,array<string,mixed>> $decoded */
+				return $decoded;
+			}
+			Minz_Log::warning('OIDC_PROVIDERS is not valid JSON; the per-host map is ignored');
+		}
+		$fromConf = FreshRSS_Context::systemConf()->oidc_providers;
+		return is_array($fromConf) ? $fromConf : [];
+	}
+
+	/** The host the current request was addressed to, lower-cased, without a port. */
+	private static function currentHost(): string {
+		$host = parse_url(self::publicBaseUrl(), PHP_URL_HOST);
+		return is_string($host) ? strtolower($host) : '';
+	}
+
+	/** @return array{metadata_url:string,client_id:string,client_secret:string,scopes:string,
+	 *               claim:string,username_map:array<string,string>,auto_register:bool,
+	 *               allow_insecure:bool,logout_redirect:bool} */
+	private static function cfg(): array {
+		/** @var array{metadata_url:string,client_id:string,client_secret:string,scopes:string,
+		 *       claim:string,username_map:array<string,string>,auto_register:bool,
+		 *       allow_insecure:bool,logout_redirect:bool} */
+		return self::config();
+	}
+
+	/** An environment variable, treating an empty value as absent. */
+	private static function env(string $name): ?string {
+		$value = getenv($name);
+		return is_string($value) && $value !== '' ? $value : null;
+	}
+
+	public static function isConfigured(): bool {
+		$c = self::cfg();
+		return $c['metadata_url'] !== '' && $c['client_id'] !== '' && $c['client_secret'] !== '';
+	}
+
+	// ---------------------------------------------------------------------------------------
+	// URLs
+	// ---------------------------------------------------------------------------------------
+
+	/**
+	 * The redirect URI announced to the provider and sent again with the code exchange.
+	 *
+	 * It is derived from the request, so one instance served through several domains announces the
+	 * right one on each — but every domain must have been registered at the provider, byte for byte.
+	 */
+	public static function redirectUri(): string {
+		return self::publicBaseUrl() . '/i/?c=auth&a=oidcCallback';
+	}
+
+	/**
+	 * The public root to build OIDC URLs from.
+	 *
+	 * A full `base_url` pins one domain and is honoured. Otherwise the host follows the request, so
+	 * each domain announces its own redirect URI. Deliberately **not** `canonicalBaseUrl()`: that one
+	 * prefers `websub_base_url`, which is pinned to a single domain, and using it here would send
+	 * every domain's login to that one host.
+	 */
+	private static function publicBaseUrl(): string {
+		$base = Minz_Request::getBaseUrl();
+		if ($base === '') {
+			$base = Minz_Request::guessBaseUrl();
+		}
+		return rtrim($base, '/');
+	}
+
+	/**
+	 * @param string $state @param string $nonce @param string $codeVerifier
+	 * @throws Minz_Exception when the provider metadata cannot be loaded
+	 */
+	public static function authorizationUrl(string $state, string $nonce, string $codeVerifier): string {
+		$metadata = self::metadata();
+		$endpoint = self::stringField($metadata, 'authorization_endpoint');
+		$params = [
+			'response_type' => 'code',
+			'client_id' => self::cfg()['client_id'],
+			'redirect_uri' => self::redirectUri(),
+			'scope' => self::cfg()['scopes'],
+			'state' => $state,
+			'nonce' => $nonce,
+			'code_challenge' => self::base64UrlEncode(hash('sha256', $codeVerifier, true)),
+			'code_challenge_method' => 'S256',
+		];
+		$separator = str_contains($endpoint, '?') ? '&' : '?';
+		return $endpoint . $separator . http_build_query($params, '', '&', PHP_QUERY_RFC3986);
+	}
+
+	/**
+	 * RP-initiated logout, when the provider advertises one and the option is enabled.
+	 * Returns '' to fall back to a local logout.
+	 */
+	public static function endSessionUrl(): string {
+		$c = self::cfg();
+		if (!$c['logout_redirect']) {
+			return '';
+		}
+		try {
+			$metadata = self::metadata();
+		} catch (Minz_Exception $e) {
+			Minz_Log::warning('OIDC: no end_session_endpoint available: ' . $e->getMessage());
+			return '';
+		}
+		$endpoint = is_string($metadata['end_session_endpoint'] ?? null) ? $metadata['end_session_endpoint'] : '';
+		if ($endpoint === '') {
+			return '';
+		}
+		$params = [
+			'client_id' => $c['client_id'],
+			'post_logout_redirect_uri' => self::publicBaseUrl() . '/i/',
+		];
+		$separator = str_contains($endpoint, '?') ? '&' : '?';
+		return $endpoint . $separator . http_build_query($params, '', '&', PHP_QUERY_RFC3986);
+	}
+
+	// ---------------------------------------------------------------------------------------
+	// Token endpoint
+	// ---------------------------------------------------------------------------------------
+
+	/**
+	 * Exchange an authorization code for tokens over the back channel.
+	 *
+	 * @return array<string,mixed>
+	 * @throws Minz_Exception
+	 */
+	public static function exchangeCode(string $code, string $codeVerifier): array {
+		$c = self::cfg();
+		$metadata = self::metadata();
+		$endpoint = self::stringField($metadata, 'token_endpoint');
+
+		$body = [
+			'grant_type' => 'authorization_code',
+			'code' => $code,
+			'redirect_uri' => self::redirectUri(),
+			'client_id' => $c['client_id'],
+			'code_verifier' => $codeVerifier,
+		];
+
+		// client_secret_basic is the recommended method; some providers only implement
+		// client_secret_post, so a 401 is retried once with the secret in the body.
+		$headers = [
+			'Content-Type: application/x-www-form-urlencoded',
+			'Accept: application/json',
+		];
+		if ($c['client_secret'] !== '') {
+			$headers[] = 'Authorization: Basic ' . base64_encode(
+				rawurlencode($c['client_id']) . ':' . rawurlencode($c['client_secret']));
+		}
+		$response = self::httpPost($endpoint, http_build_query($body, '', '&'), $headers);
+		if ($response['status'] === 401 && $c['client_secret'] !== '') {
+			$body['client_secret'] = $c['client_secret'];
+			$response = self::httpPost($endpoint, http_build_query($body, '', '&'), [
+				'Content-Type: application/x-www-form-urlencoded',
+				'Accept: application/json',
+			]);
+		}
+		if ($response['status'] < 200 || $response['status'] >= 300) {
+			throw new Minz_Exception('OIDC token endpoint returned HTTP ' . $response['status']);
+		}
+		$decoded = json_decode($response['body'], true);
+		if (!is_array($decoded)) {
+			throw new Minz_Exception('OIDC token endpoint did not return a JSON object');
+		}
+		/** @var array<string,mixed> $decoded */
+		return $decoded;
+	}
+
+	// ---------------------------------------------------------------------------------------
+	// ID token verification
+	// ---------------------------------------------------------------------------------------
+
+	/**
+	 * Verify an ID token and return its claims.
+	 *
+	 * Fails closed: an unsupported algorithm, an unknown key, a bad signature or any failed claim
+	 * check throws, and the caller must treat that as "not authenticated".
+	 *
+	 * @return array<string,mixed>
+	 * @throws Minz_Exception
+	 */
+	public static function verifyIdToken(string $idToken, string $expectedNonce): array {
+		$c = self::cfg();
+		$metadata = self::metadata();
+		$jwksUrl = self::stringField($metadata, 'jwks_uri');
+		$jwks = self::cachedJson('jwks', $jwksUrl, self::JWKS_TTL);
+		try {
+			return self::verifyToken($idToken, $metadata, $jwks, $c['client_id'], $expectedNonce);
+		} catch (Minz_Exception $e) {
+			// A provider may rotate its signing key while keeping the same `kid`. Without this, a
+			// cached key would lock every user out for the whole cache lifetime — and the symptom
+			// ("login is invalid") says nothing about the cause. On a signature or key error, drop
+			// the cache and verify once more against a freshly fetched key set.
+			$message = $e->getMessage();
+			if (!str_contains($message, 'signature') && !str_contains($message, 'signing key')) {
+				throw $e;
+			}
+			@unlink(self::cachePath('jwks', $jwksUrl));
+			Minz_Log::warning('OIDC: key check failed, refetched JWKS: ' . $message);
+			$jwks = self::cachedJson('jwks', $jwksUrl, self::JWKS_TTL);
+			return self::verifyToken($idToken, $metadata, $jwks, $c['client_id'], $expectedNonce);
+		}
+	}
+
+	/**
+	 * Verify a token against an explicit discovery document and key set.
+	 *
+	 * Separate from {@see self::verifyIdToken()} so the verifier can be tested against a generated
+	 * key, without a provider, a cache or a configuration file.
+	 *
+	 * @param array<string,mixed> $metadata
+	 * @param array<string,mixed> $jwks
+	 * @return array<string,mixed>
+	 * @throws Minz_Exception
+	 */
+	public static function verifyToken(string $idToken, array $metadata, array $jwks,
+		string $clientId, string $expectedNonce): array {
+		$issuer = self::stringField($metadata, 'issuer');
+
+		$parts = explode('.', $idToken);
+		if (count($parts) !== 3) {
+			throw new Minz_Exception('OIDC ID token is not a compact JWS');
+		}
+		$headerRaw = self::base64UrlDecode($parts[0]);
+		$payloadRaw = self::base64UrlDecode($parts[1]);
+		$signature = self::base64UrlDecode($parts[2]);
+		if ($headerRaw === null || $payloadRaw === null || $signature === null) {
+			throw new Minz_Exception('OIDC ID token is not valid base64url');
+		}
+		$header = json_decode($headerRaw, true);
+		$claims = json_decode($payloadRaw, true);
+		if (!is_array($header) || !is_array($claims)) {
+			throw new Minz_Exception('OIDC ID token header or claims are not JSON objects');
+		}
+		/** @var array<string,mixed> $header */
+		/** @var array<string,mixed> $claims */
+
+		// Algorithm confusion is the classic JWT vulnerability: refuse anything but RS256 rather
+		// than trusting the token to name its own algorithm, and never honour `none`.
+		$alg = is_string($header['alg'] ?? null) ? $header['alg'] : '';
+		if ($alg !== 'RS256') {
+			throw new Minz_Exception('OIDC ID token algorithm not accepted: ' . $alg);
+		}
+
+		$kid = is_string($header['kid'] ?? null) ? $header['kid'] : '';
+		$publicKey = self::publicKeyFor($jwks, $kid);
+		$verified = openssl_verify($parts[0] . '.' . $parts[1], $signature, $publicKey, OPENSSL_ALGO_SHA256);
+		if ($verified !== 1) {
+			throw new Minz_Exception('OIDC ID token signature is invalid');
+		}
+
+		$now = time();
+		$tokenIssuer = is_string($claims['iss'] ?? null) ? $claims['iss'] : '';
+		if ($tokenIssuer === '' || $tokenIssuer !== $issuer) {
+			throw new Minz_Exception('OIDC ID token issuer mismatch');
+		}
+
+		$audience = $claims['aud'] ?? null;
+		$audiences = is_array($audience) ? $audience : [$audience];
+		if (!in_array($clientId, $audiences, true)) {
+			throw new Minz_Exception('OIDC ID token audience mismatch');
+		}
+		// When the token was issued to several audiences, `azp` must name this client.
+		if (isset($claims['azp']) && is_string($claims['azp']) && $claims['azp'] !== $clientId) {
+			throw new Minz_Exception('OIDC ID token authorised party mismatch');
+		}
+
+		$expires = is_int($claims['exp'] ?? null) ? $claims['exp'] : 0;
+		if ($expires === 0 || $expires + self::CLOCK_SKEW < $now) {
+			throw new Minz_Exception('OIDC ID token is expired');
+		}
+		$notBefore = is_int($claims['nbf'] ?? null) ? $claims['nbf'] : null;
+		if ($notBefore !== null && $notBefore - self::CLOCK_SKEW > $now) {
+			throw new Minz_Exception('OIDC ID token is not valid yet');
+		}
+		$issuedAt = is_int($claims['iat'] ?? null) ? $claims['iat'] : null;
+		if ($issuedAt !== null && $issuedAt - self::CLOCK_SKEW > $now) {
+			throw new Minz_Exception('OIDC ID token was issued in the future');
+		}
+
+		// The nonce binds this token to the request that started the flow, which is what stops a
+		// token obtained elsewhere from being replayed into someone else's session.
+		$nonce = is_string($claims['nonce'] ?? null) ? $claims['nonce'] : '';
+		if ($nonce === '' || !hash_equals($expectedNonce, $nonce)) {
+			throw new Minz_Exception('OIDC ID token nonce mismatch');
+		}
+
+		return $claims;
+	}
+
+	/**
+	 * The FreshRSS username carried by the configured claim.
+	 *
+	 * @param array<string,mixed> $claims
+	 * @throws Minz_Exception
+	 */
+	public static function usernameFromClaims(array $claims): string {
+		$provider = self::cfg();
+		return self::resolveUsername($claims, $provider['claim'], $provider['username_map']);
+	}
+
+	/**
+	 * Turn the identity provider's name for a user into the FreshRSS account to sign in as.
+	 *
+	 * The two are usually the same string, and then this is the identity. When they differ — the
+	 * provider says `alice@corp.example` while the account is `alice` — an explicit map says which
+	 * account a provider identity owns. That is the only safe way to bind: guessing from an email
+	 * local part or a display name would let one account claim another.
+	 *
+	 * @param array<string,mixed> $claims
+	 * @param array<string,string> $usernameMap provider identity => FreshRSS username
+	 * @throws Minz_Exception
+	 */
+	public static function resolveUsername(array $claims, string $claim, array $usernameMap): string {
+		$username = $claims[$claim] ?? null;
+		if (!is_string($username) || $username === '') {
+			throw new Minz_Exception('OIDC ID token has no usable “' . $claim . '” claim');
+		}
+		$username = trim($username);
+		$mapped = $usernameMap[$username] ?? '';
+		if ($mapped !== '') {
+			$username = $mapped;
+		}
+		if (!FreshRSS_user_Controller::checkUsername($username)) {
+			throw new Minz_Exception('the identity provider’s name is not a valid FreshRSS username');
+		}
+		return $username;
+	}
+
+	// ---------------------------------------------------------------------------------------
+	// Discovery and keys
+	// ---------------------------------------------------------------------------------------
+
+	/**
+	 * @return array<string,mixed>
+	 * @throws Minz_Exception
+	 */
+	public static function metadata(): array {
+		$c = self::cfg();
+		if ($c['metadata_url'] === '') {
+			throw new Minz_Exception('OIDC is enabled but no provider metadata URL is configured');
+		}
+		return self::cachedJson('metadata', $c['metadata_url'], self::METADATA_TTL);
+	}
+
+	/**
+	 * @param array<string,mixed> $jwks
+	 * @throws Minz_Exception
+	 */
+	private static function publicKeyFor(array $jwks, string $kid): string {
+		$keys = $jwks['keys'] ?? null;
+		if (!is_array($keys) || $keys === []) {
+			throw new Minz_Exception('OIDC JWKS contains no keys');
+		}
+		$fallback = null;
+		foreach ($keys as $key) {
+			if (!is_array($key)) {
+				continue;
+			}
+			/** @var array<string,mixed> $key */
+			$keyId = is_string($key['kid'] ?? null) ? $key['kid'] : '';
+			$pem = self::pemFromJwk($key);
+			if ($pem === null) {
+				continue;
+			}
+			if ($kid !== '' && $keyId === $kid) {
+				return $pem;
+			}
+			// A provider may publish a single key and omit `kid` from the token.
+			if ($kid === '' && $fallback === null) {
+				$fallback = $pem;
+			}
+		}
+		if ($fallback !== null) {
+			return $fallback;
+		}
+		throw new Minz_Exception('OIDC signing key not found for kid “' . $kid . '”');
+	}
+
+	/**
+	 * Read a JSON document through a small on-disk cache.
+	 *
+	 * A stale cache is accepted when the provider is temporarily unreachable: refusing every login
+	 * because the network blipped is worse than trusting a document that was valid an hour ago. With
+	 * no cache at all there is nothing to trust, so the exception propagates.
+	 *
+	 * @return array<string,mixed>
+	 * @throws Minz_Exception
+	 */
+	private static function cachedJson(string $name, string $url, int $ttl): array {
+		// Keyed by URL as well: with several providers, a shared file name would make one provider's
+		// keys answer for another's.
+		$path = self::cachePath($name, $url);
+		$cached = self::readCached($path, $url);
+		if ($cached !== null && time() - $cached['fetched'] <= $ttl) {
+			return $cached['data'];
+		}
+		try {
+			$data = self::httpGetJson($url);
+		} catch (Minz_Exception $e) {
+			if ($cached !== null) {
+				Minz_Log::warning('OIDC: using stale ' . $name . ' cache: ' . $e->getMessage());
+				return $cached['data'];
+			}
+			throw $e;
+		}
+		self::writeCached($path, $url, $data);
+		return $data;
+	}
+
+	/**
+	 * @return array{fetched:int,url:string,data:array<string,mixed>}|null
+	 */
+	private static function readCached(string $path, string $url): ?array {
+		$raw = @file_get_contents($path);
+		if (!is_string($raw) || $raw === '') {
+			return null;
+		}
+		$decoded = json_decode($raw, true);
+		if (!is_array($decoded) || !is_array($decoded['data'] ?? null) ||
+			!is_int($decoded['fetched'] ?? null) || ($decoded['url'] ?? null) !== $url) {
+			return null;
+		}
+		/** @var array<string,mixed> $data */
+		$data = $decoded['data'];
+		return ['fetched' => $decoded['fetched'], 'url' => $url, 'data' => $data];
+	}
+
+	/** @param array<string,mixed> $data */
+	private static function writeCached(string $path, string $url, array $data): void {
+		$dir = dirname($path);
+		if (!is_dir($dir)) {
+			@mkdir($dir, 0770, true);
+		}
+		@file_put_contents($path, json_encode(
+			['fetched' => time(), 'url' => $url, 'data' => $data], JSON_UNESCAPED_SLASHES));
+	}
+
+	private static function cacheDir(): string {
+		return DATA_PATH . '/cache/oidc';
+	}
+
+	private static function cachePath(string $name, string $url): string {
+		return self::cacheDir() . '/' . $name . '-' . substr(sha1($url), 0, 16) . '.json';
+	}
+
+	/**
+	 * @return array<string,mixed>
+	 * @throws Minz_Exception
+	 */
+	private static function httpGetJson(string $url): array {
+		self::assertUrlAllowed($url);
+		$ch = curl_init($url);
+		if ($ch === false) {
+			throw new Minz_Exception('OIDC: cannot initialise HTTP client');
+		}
+		curl_setopt_array($ch, [
+			CURLOPT_RETURNTRANSFER => true,
+			CURLOPT_FOLLOWLOCATION => false,
+			CURLOPT_CONNECTTIMEOUT => 5,
+			CURLOPT_TIMEOUT => self::HTTP_TIMEOUT,
+			CURLOPT_HTTPHEADER => ['Accept: application/json', 'User-Agent: FreshRSS/' . FRESHRSS_VERSION],
+		]);
+		$body = curl_exec($ch);
+		$status = (int)curl_getinfo($ch, CURLINFO_RESPONSE_CODE);
+		$error = curl_error($ch);
+		curl_close($ch);
+		if (!is_string($body) || $status < 200 || $status >= 300) {
+			throw new Minz_Exception('OIDC: GET ' . $url . ' failed (HTTP ' . $status . ' ' . $error . ')');
+		}
+		$decoded = json_decode($body, true);
+		if (!is_array($decoded)) {
+			throw new Minz_Exception('OIDC: ' . $url . ' did not return a JSON object');
+		}
+		/** @var array<string,mixed> $decoded */
+		return $decoded;
+	}
+
+	/**
+	 * @param list<string> $headers
+	 * @return array{status:int,body:string,error:string}
+	 */
+	private static function httpPost(string $url, string $body, array $headers): array {
+		try {
+			self::assertUrlAllowed($url);
+		} catch (Minz_Exception $e) {
+			return ['status' => 0, 'body' => '', 'error' => $e->getMessage()];
+		}
+		$ch = curl_init($url);
+		if ($ch === false) {
+			return ['status' => 0, 'body' => '', 'error' => 'cannot initialise HTTP client'];
+		}
+		curl_setopt_array($ch, [
+			CURLOPT_RETURNTRANSFER => true,
+			CURLOPT_FOLLOWLOCATION => false,
+			CURLOPT_POST => true,
+			CURLOPT_POSTFIELDS => $body,
+			CURLOPT_CONNECTTIMEOUT => 5,
+			CURLOPT_TIMEOUT => self::HTTP_TIMEOUT,
+			CURLOPT_HTTPHEADER => $headers,
+		]);
+		$response = curl_exec($ch);
+		$status = (int)curl_getinfo($ch, CURLINFO_RESPONSE_CODE);
+		$error = curl_error($ch);
+		curl_close($ch);
+		return [
+			'status' => $status,
+			'body' => is_string($response) ? $response : '',
+			'error' => $error,
+		];
+	}
+
+	/**
+	 * Refuse a plaintext endpoint unless explicitly allowed.
+	 *
+	 * Client secrets and ID tokens travel over these URLs; accepting `http://` by default would make
+	 * a misconfiguration an interception, not a bug. Tests and local development opt in.
+	 *
+	 * @throws Minz_Exception
+	 */
+	private static function assertUrlAllowed(string $url): void {
+		$parts = parse_url($url);
+		$scheme = is_array($parts) && is_string($parts['scheme'] ?? null) ? strtolower($parts['scheme']) : '';
+		$host = is_array($parts) && is_string($parts['host'] ?? null) ? $parts['host'] : '';
+		if ($host === '' || ($scheme !== 'https' && $scheme !== 'http')) {
+			throw new Minz_Exception('OIDC: invalid provider URL: ' . $url);
+		}
+		if ($scheme !== 'https' && !self::cfg()['allow_insecure']) {
+			throw new Minz_Exception('OIDC: refusing a plaintext provider URL, set OIDC_ALLOW_INSECURE=1 to allow it');
+		}
+	}
+
+	/** @param array<string,mixed> $data @throws Minz_Exception */
+	private static function stringField(array $data, string $field): string {
+		$value = $data[$field] ?? null;
+		if (!is_string($value) || $value === '') {
+			throw new Minz_Exception('OIDC discovery document has no “' . $field . '”');
+		}
+		return $value;
+	}
+
+	// ---------------------------------------------------------------------------------------
+	// JWK → PEM (RS256 only)
+	// ---------------------------------------------------------------------------------------
+
+	/**
+	 * @param array<string,mixed> $jwk
+	 * @return string|null PEM public key, or null when the JWK is not an RSA signing key
+	 */
+	private static function pemFromJwk(array $jwk): ?string {
+		$kty = is_string($jwk['kty'] ?? null) ? $jwk['kty'] : '';
+		if ($kty !== 'RSA') {
+			return null;
+		}
+		$n = is_string($jwk['n'] ?? null) ? self::base64UrlDecode($jwk['n']) : null;
+		$e = is_string($jwk['e'] ?? null) ? self::base64UrlDecode($jwk['e']) : null;
+		if ($n === null || $e === null || $n === '' || $e === '') {
+			return null;
+		}
+
+		$modulus = self::derInteger($n);
+		$exponent = self::derInteger($e);
+		$rsaPublicKey = self::derSequence($modulus . $exponent);
+
+		$algorithm = self::derSequence(
+			// OID 1.2.840.113549.1.1.1 (rsaEncryption) followed by NULL parameters
+			"\x06\x09\x2a\x86\x48\x86\xf7\x0d\x01\x01\x01\x05\x00"
+		);
+		$bitString = "\x03" . self::derLength(strlen($rsaPublicKey) + 1) . "\x00" . $rsaPublicKey;
+		$subjectPublicKeyInfo = self::derSequence($algorithm . $bitString);
+
+		$pem = "-----BEGIN PUBLIC KEY-----\n"
+			. chunk_split(base64_encode($subjectPublicKeyInfo), 64, "\n")
+			. "-----END PUBLIC KEY-----\n";
+		$key = openssl_pkey_get_public($pem);
+		return $key === false ? null : $pem;
+	}
+
+	private static function derSequence(string $body): string {
+		return "\x30" . self::derLength(strlen($body)) . $body;
+	}
+
+	/** DER INTEGER: strip leading zeroes, then re-add one if the high bit would make it negative. */
+	private static function derInteger(string $bytes): string {
+		$bytes = ltrim($bytes, "\x00");
+		if ($bytes === '') {
+			$bytes = "\x00";
+		}
+		if ((ord($bytes[0]) & 0x80) !== 0) {
+			$bytes = "\x00" . $bytes;
+		}
+		return "\x02" . self::derLength(strlen($bytes)) . $bytes;
+	}
+
+	private static function derLength(int $length): string {
+		if ($length < 0x80) {
+			return chr($length);
+		}
+		$encoded = ltrim(pack('N', $length), "\x00");
+		return chr(0x80 | strlen($encoded)) . $encoded;
+	}
+
+	private static function base64UrlDecode(string $value): ?string {
+		$padded = strtr($value, '-_', '+/');
+		$remainder = strlen($padded) % 4;
+		if ($remainder !== 0) {
+			$padded .= str_repeat('=', 4 - $remainder);
+		}
+		$decoded = base64_decode($padded, true);
+		return $decoded === false ? null : $decoded;
+	}
+
+	private static function base64UrlEncode(string $value): string {
+		return rtrim(strtr(base64_encode($value), '+/', '-_'), '=');
+	}
+}
