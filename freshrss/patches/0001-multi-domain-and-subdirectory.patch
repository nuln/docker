+	public function testTheProviderNameIsUsedAsIsWhenNoMapIsConfigured(): void {
+		$name = FreshRSS_Oidc::resolveUsername(['preferred_username' => 'alice'], 'preferred_username', []);
+		self::assertSame('alice', $name);
+	}
+
+	public function testAMappedIdentitySignsInAsTheExistingAccount(): void {
+		$name = FreshRSS_Oidc::resolveUsername(
+			['preferred_username' => 'alice@corp.example'],
+			'preferred_username',
+			['alice@corp.example' => 'alice'],
+		);
+		self::assertSame('alice', $name);
+	}
+
+	public function testAnUnmappedIdentityIsUnaffectedByOtherEntries(): void {
+		$name = FreshRSS_Oidc::resolveUsername(
+			['preferred_username' => 'bob@corp.example'],
+			'preferred_username',
+			['alice@corp.example' => 'alice'],
+		);
+		self::assertSame('bob@corp.example', $name);
+	}
+
+	public function testAMapCannotPointAtAnInvalidUsername(): void {
+		$this->expectException(Minz_Exception::class);
+		FreshRSS_Oidc::resolveUsername(
+			['preferred_username' => 'alice@corp.example'],
+			'preferred_username',
+			['alice@corp.example' => 'not a valid name'],
+		);
+	}
+
+	public function testAMissingClaimIsRefused(): void {
+		$this->expectException(Minz_Exception::class);
+		FreshRSS_Oidc::resolveUsername(['email' => 'alice@corp.example'], 'preferred_username', []);
+	}
+}
diff --git a/tests/lib/Minz/RequestTest.php b/tests/lib/Minz/RequestTest.php
new file mode 100644
index 000000000..b65c34014
--- /dev/null
+++ b/tests/lib/Minz/RequestTest.php
@@ -0,0 +1,243 @@
+<?php
+declare(strict_types=1);
+
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Multi-domain and sub-directory support.
+ *
+ * `base_url` may be a path (e.g. `/rss`) or empty, in which case the host is resolved from
+ * the current request so that one instance can be served through several domains. These
+ * tests pin the two invariants that makes this safe:
+ *
+ *  1. `applicationPath()` returns the *public root* of the instance, never the directory of
+ *     the current page, so that appending `PUBLIC_TO_INDEX_PATH` cannot produce `/i/i`;
+ *  2. `guessBaseUrl()` is stable across entry points (`p/`, `p/i/`, `p/api/`, `p/f.php`).
+ *
+ * @see \Minz_Request::applicationPath()
+ * @see \Minz_Request::guessBaseUrl()
+ */
+final class RequestTest extends TestCase {
+
+	private static string $configFile;
+	private static string $defaultFile;
+
+	#[\Override]
+	public static function setUpBeforeClass(): void {
+		$dir = sys_get_temp_dir() . '/freshrss-test-' . getmypid();
+		if (!is_dir($dir)) {
+			mkdir($dir, 0o777, true);
+		}
+		self::$configFile = $dir . '/config.php';
+		self::$defaultFile = $dir . '/config.default.php';
+		// Minimal stand-in for ./data/config.php and ./config.default.php
+		file_put_contents(self::$defaultFile, '<?php return ' . var_export([
+			'base_url' => '',
+			'websub_base_url' => '',
+			'allowed_hosts' => [],
+		], true) . ';');
+	}
+
+	#[\Override]
+	public static function tearDownAfterClass(): void {
+		foreach ([self::$configFile, self::$defaultFile] as $file) {
+			if (is_file($file)) {
+				unlink($file);
+			}
+		}
+		$dir = sys_get_temp_dir() . '/freshrss-test-' . getmypid();
+		if (is_dir($dir)) {
+			rmdir($dir);
+		}
+	}
+
+	/**
+	 * @param array<string,mixed> $system
+	 */
+	private static function useConfig(array $system): void {
+		file_put_contents(self::$configFile, '<?php return ' . var_export($system, true) . ';');
+		Minz_Configuration::register('system', self::$configFile, self::$defaultFile);
+	}
+
+	/**
+	 * @param array<string,string> $server
+	 */
+	private static function request(array $server): void {
+		$_SERVER = $server;
+	}
+
+	/**
+	 * Reverse proxy that forwards the public path unchanged (Apache `Alias` mode).
+	 *
+	 * @return array<string,string>
+	 */
+	private static function proxyKeepingPrefix(string $host, string $prefix = '/rss', string $script = '/i/index.php',
+		string $uri = '/i/?c=index&a=index'): array {
+		return [
+			'SCRIPT_NAME' => $prefix . $script,
+			'REQUEST_URI' => $prefix . $uri,
+			'HTTP_X_FORWARDED_HOST' => $host,
+			'HTTP_X_FORWARDED_PROTO' => 'https',
+			'HTTP_X_FORWARDED_PORT' => '443',
+		];
+	}
+
+	// -- applicationPath() -------------------------------------------------------------------
+
+	/**
+	 * @return array<string,array{0:string,1:string}>
+	 */
+	public static function provideScriptNames(): array {
+		return [
+			'root, web interface'  => ['/i/index.php', ''],
+			'root, landing'        => ['/index.php', ''],
+			'root, favicon'        => ['/f.php', ''],
+			'root, extension'      => ['/ext.php', ''],
+			'/rss, web interface'  => ['/rss/i/index.php', '/rss'],
+			'/rss, landing'        => ['/rss/index.php', '/rss'],
+			'/rss, favicon'        => ['/rss/f.php', '/rss'],
+			'/rss, extension'      => ['/rss/ext.php', '/rss'],
+			'/rss, WebSub'         => ['/rss/api/pshb.php', '/rss'],
+			'/rss, OIDC'           => ['/rss/i/oidc/index.php', '/rss'],
+			'nested prefix'        => ['/a/b/i/index.php', '/a/b'],
+		];
+	}
+
+	/**
+	 * @dataProvider provideScriptNames
+	 */
+	public static function testApplicationPathFromScriptName(string $scriptName, string $expected): void {
+		self::request(['SCRIPT_NAME' => $scriptName]);
+		self::assertSame($expected, Minz_Request::applicationPath());
+	}
+
+	public static function testApplicationPathPrefersForwardedPrefix(): void {
+		// Reverse proxy stripping the prefix (Caddy `handle_path` + X-Forwarded-Prefix)
+		self::request(['SCRIPT_NAME' => '/i/index.php', 'HTTP_X_FORWARDED_PREFIX' => '/rss']);
+		self::assertSame('/rss', Minz_Request::applicationPath());
+
+		self::request(['SCRIPT_NAME' => '/i/index.php', 'HTTP_X_FORWARDED_PREFIX' => '/rss/']);
+		self::assertSame('/rss', Minz_Request::applicationPath());
+	}
+
+	public static function testApplicationPathWithoutAnyPrefix(): void {
+		self::request(['SCRIPT_NAME' => '/i/index.php']);
+		self::assertSame('', Minz_Request::applicationPath());
+	}
+
+	// -- guessBaseUrl() ---------------------------------------------------------------------
+
+	public static function testGuessBaseUrlFollowsTheRequestHost(): void {
+		self::useConfig(['base_url' => '/rss']);
+		foreach (['a.example', 'b.example', 'cn.example.org'] as $host) {
+			self::request(self::proxyKeepingPrefix($host));
+			self::assertSame("https://$host/rss", Minz_Request::guessBaseUrl());
+		}
+	}
+
+	/**
+	 * @return array<string,array{0:string,1:string,2:string}>
+	 */
+	public static function provideEntryPoints(): array {
+		// Paths are relative to the public prefix, i.e. to `p/`.
+		return [
+			'landing'   => ['/index.php', '/', 'https://a.example/rss'],
+			'web UI'    => ['/i/index.php', '/i/?c=index&a=index', 'https://a.example/rss'],
+			'WebSub'    => ['/api/pshb.php', '/api/pshb.php?k=abc', 'https://a.example/rss'],
+			'favicon'   => ['/f.php', '/f.php?h=deadbeef', 'https://a.example/rss'],
+			'extension' => ['/ext.php', '/ext.php?f=x.css', 'https://a.example/rss'],
+		];
+	}
+
+	/**
+	 * The public root must be the same for every entry point, and appending
+	 * PUBLIC_TO_INDEX_PATH must never produce a duplicated `/i`.
+	 *
+	 * @dataProvider provideEntryPoints
+	 */
+	public static function testGuessBaseUrlIsStableAcrossEntryPoints(string $script, string $uri, string $expected): void {
+		self::useConfig(['base_url' => '/rss']);
+		self::request(self::proxyKeepingPrefix('a.example', '/rss', $script, $uri));
+		self::assertSame($expected, Minz_Request::guessBaseUrl());
+
+		$built = Minz_Request::guessBaseUrl() . PUBLIC_TO_INDEX_PATH;
+		self::assertSame('/rss/i', parse_url($built, PHP_URL_PATH));
+		self::assertStringNotContainsString('/i/i', $built);
+	}
+
+	public static function testGuessBaseUrlIsIdenticalOnEveryDomain(): void {
+		self::useConfig(['base_url' => '/rss']);
+		$paths = [];
+		$entryPoints = self::provideEntryPoints();
+		foreach (['a.example', 'b.example'] as $host) {
+			foreach ($entryPoints as [$script, $uri]) {
+				self::request(self::proxyKeepingPrefix($host, '/rss', $script, $uri));
+				$paths[] = (string)parse_url(Minz_Request::guessBaseUrl(), PHP_URL_PATH);
+			}
+		}
+		self::assertSame(['/rss'], array_values(array_unique($paths)));
+	}
+
+	// -- getBaseUrl() / canonicalBaseUrl() ---------------------------------------------------
+
+	public static function testFullUrlBaseUrlIsPinned(): void {
+		self::useConfig(['base_url' => 'https://pinned.example.net/rss']);
+		self::request(self::proxyKeepingPrefix('a.example'));
+		self::assertSame('https://pinned.example.net/rss', Minz_Request::getBaseUrl());
+		self::assertSame('https://pinned.example.net/rss', Minz_Request::canonicalBaseUrl());
+	}
+
+	public static function testPathOnlyBaseUrlIsNotAnAbsoluteUrl(): void {
+		self::useConfig(['base_url' => '/rss']);
+		self::request(self::proxyKeepingPrefix('a.example'));
+		// Empty, so that Minz_Url::display() falls back to the request.
+		self::assertSame('', Minz_Request::getBaseUrl());
+	}
+
+	public static function testWebSubBaseUrlIsPinnedOnEveryDomain(): void {
+		self::useConfig(['base_url' => '/rss', 'websub_base_url' => 'https://rss.example.net/rss']);
+		foreach (['a.example', 'b.example', 'cn.example.org'] as $host) {
+			self::request(self::proxyKeepingPrefix($host));
+			self::assertSame('https://rss.example.net/rss/api/pshb.php?k=abc',
+				Minz_Request::canonicalBaseUrl() . '/api/pshb.php?k=abc');
+			self::assertTrue(Minz_Request::serverIsPublic(Minz_Request::canonicalBaseUrl()));
+		}
+	}
+
+	public static function testWebSubStaysDisabledWithoutAnAbsoluteUrl(): void {
+		self::useConfig(['base_url' => '/rss', 'websub_base_url' => '']);
+		self::request(self::proxyKeepingPrefix('a.example'));
+		// The refresh cron job runs under the CLI SAPI, with no request to guess a host from:
+		// advertising a wrong callback is worse than advertising none.
+		self::assertSame('', Minz_Request::canonicalBaseUrl());
+		self::assertFalse(Minz_Request::serverIsPublic(Minz_Request::canonicalBaseUrl()));
+		self::assertFalse(Minz_Request::serverIsPublic('/rss'));
+	}
+
+	// -- allowed_hosts -----------------------------------------------------------------------
+
+	public static function testAllowedHostsKeepsKnownHosts(): void {
+		self::useConfig(['base_url' => '/rss', 'allowed_hosts' => ['a.example', 'b.example']]);
+		self::request(self::proxyKeepingPrefix('a.example'));
+		self::assertSame('https://a.example/rss', Minz_Request::guessBaseUrl());
+		self::request(self::proxyKeepingPrefix('b.example'));
+		self::assertSame('https://b.example/rss', Minz_Request::guessBaseUrl());
+	}
+
+	public static function testAllowedHostsNeutralisesHostHeaderInjection(): void {
+		self::useConfig(['base_url' => '/rss', 'allowed_hosts' => ['a.example', 'b.example']]);
+		self::request(self::proxyKeepingPrefix('evil.example'));
+		self::assertSame('https://a.example/rss', Minz_Request::guessBaseUrl());
+	}
+
+	public static function testEmptyAllowedHostsAcceptsAnyHost(): void {
+		self::useConfig(['base_url' => '/rss', 'allowed_hosts' => []]);
+		self::request(self::proxyKeepingPrefix('whatever.example'));
+		self::assertSame('https://whatever.example/rss', Minz_Request::guessBaseUrl());
+	}
+
+	#[\Override]
+	protected function tearDown(): void {
+		$_SERVER = [];
+	}
+}
diff --git a/tests/lib/Minz/UrlTest.php b/tests/lib/Minz/UrlTest.php
new file mode 100644
index 000000000..103d08bd1
--- /dev/null
+++ b/tests/lib/Minz/UrlTest.php
@@ -0,0 +1,249 @@
+<?php
+declare(strict_types=1);
+
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Regression tests for the URL builder.
+ *
+ * `Minz_Url::display()` used to apply a heuristic — when it had to guess the base URL it removed a
+ * trailing `/i` with `dirname()` — which was compensating for `guessBaseUrl()` returning the
+ * directory of the *current page*. Now that `guessBaseUrl()` returns the public root, that
+ * heuristic had to go: on an instance served from `/i` (a legitimate sub-directory name) it
+ * truncated the prefix to the domain root.
+ *
+ * The three modes therefore have to be pinned down:
+ *  - relative (the default, 102 of 117 call sites): no host, no prefix guessing;
+ *  - `'root'`: absolute, but reduced to the *path*;
+ *  - `true`: fully absolute.
+ *
+ * @see \Minz_Request::applicationPath()
+ */
+final class UrlTest extends TestCase {
+
+	private static string $configFile;
+	private static string $defaultFile;
+
+	#[\Override]
+	public static function setUpBeforeClass(): void {
+		$dir = sys_get_temp_dir() . '/freshrss-urltest-' . getmypid();
+		if (!is_dir($dir)) {
+			mkdir($dir, 0o777, true);
+		}
+		self::$configFile = $dir . '/config.php';
+		self::$defaultFile = $dir . '/config.default.php';
+		file_put_contents(self::$defaultFile, '<?php return ' . var_export([
+			'base_url' => '',
+			'websub_base_url' => '',
+			'allowed_hosts' => [],
+		], true) . ';');
+	}
+
+	#[Override]
+	public static function tearDownAfterClass(): void {
+		foreach ([self::$configFile, self::$defaultFile] as $file) {
+			if (is_file($file)) {
+				unlink($file);
+			}
+		}
+		$dir = sys_get_temp_dir() . '/freshrss-urltest-' . getmypid();
+		if (is_dir($dir)) {
+			rmdir($dir);
+		}
+	}
+
+	/**
+	 * @param array<string,mixed> $config
+	 * @param array<string,string> $server
+	 */
+	private static function given(array $config, array $server): void {
+		file_put_contents(self::$configFile, '<?php return ' . var_export($config, true) . ';');
+		Minz_Configuration::register('system', self::$configFile, self::$defaultFile);
+		$_SERVER = $server;
+	}
+
+	/**
+	 * @return array<string,string>
+	 */
+	private static function subDirectoryRequest(string $host = 'a.example', string $prefix = '/rss'): array {
+		return [
+			'SCRIPT_NAME' => $prefix . '/i/index.php',
+			'REQUEST_URI' => $prefix . '/i/',
+			'HTTP_X_FORWARDED_HOST' => $host,
+			'HTTP_X_FORWARDED_PROTO' => 'https',
+		];
+	}
+
+	// -- relative mode (the default) --------------------------------------------------------
+
+	public static function testRelativeModeHasNoHostAndNoPathGuess(): void {
+		self::given(['base_url' => '/rss'], self::subDirectoryRequest());
+		// Array form: a controller link, resolved against the current page.
+		self::assertSame('./', Minz_Url::display(['c' => 'index', 'a' => 'index']));
+		// String form: an asset, resolved against `p/`.
+		self::assertSame('../scripts/main.js', Minz_Url::display('/scripts/main.js'));
+		self::assertSame('../themes/icons/favicon.svg', Minz_Url::display('/themes/icons/favicon.svg'));
+	}
+
+	public static function testRelativeModeIsUnaffectedByTheBaseUrl(): void {
+		foreach (['/rss', '', 'https://pinned.example/rss'] as $baseUrl) {
+			self::given(['base_url' => $baseUrl], self::subDirectoryRequest());
+			self::assertSame('./', Minz_Url::display(['c' => 'index', 'a' => 'index']),
+				"base_url={$baseUrl}");
+		}
+	}
+
+	// -- 'root' mode: absolute, reduced to the path -------------------------------------------
+
+	public static function testRootModeYieldsThePathOnly(): void {
+		self::given(['base_url' => '/rss'], self::subDirectoryRequest());
+		self::assertSame('/rss/i/', Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', 'root'));
+	}
+
+	public static function testRootModeFollowsTheHostWithoutEmittingIt(): void {
+		self::given(['base_url' => '/rss'], self::subDirectoryRequest('b.example'));
+		$url = Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', 'root');
+		self::assertSame('/rss/i/', $url);
+		self::assertStringNotContainsString('b.example', $url);
+	}
+
+	/**
+	 * The removed heuristic truncated any base URL ending in `/i` to the domain root, so an
+	 * instance served from a sub-directory named `/i` sent every link to `/i/` instead of `/i/i/`.
+	 * `SCRIPT_NAME` alone cannot tell that case from the `/i/` entry-point, which is why the
+	 * deployment states the prefix explicitly — the same value the container hands to Apache.
+	 */
+	public static function testRootModeKeepsAPrefixThatIsItselfNamedI(): void {
+		putenv('FRESHRSS_PATH_PREFIX=/i');
+		try {
+			self::given(['base_url' => '/i'], [
+				'SCRIPT_NAME' => '/i/i/index.php',
+				'REQUEST_URI' => '/i/i/?c=index&a=index',
+				'HTTP_X_FORWARDED_HOST' => 'a.example',
+				'HTTP_X_FORWARDED_PROTO' => 'https',
+			]);
+			self::assertSame('/i', Minz_Request::applicationPath());
+			self::assertSame('/i/i/',
+				Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', 'root'));
+			self::assertSame('https://a.example/i/i/',
+				Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', true));
+		} finally {
+			putenv('FRESHRSS_PATH_PREFIX');
+		}
+	}
+
+	public static function testConfiguredPrefixWinsOverTheForwardedHeader(): void {
+		// A stripping proxy advertises the prefix a second time; the configured value is what
+		// Apache was set up with, and it must not be double-applied.
+		putenv('FRESHRSS_PATH_PREFIX=/rss/');
+		try {
+			self::given(['base_url' => '/rss'], [
+				'SCRIPT_NAME' => '/i/index.php',
+				'REQUEST_URI' => '/i/?c=index&a=index',
+				'HTTP_X_FORWARDED_HOST' => 'a.example',
+				'HTTP_X_FORWARDED_PROTO' => 'https',
+				'HTTP_X_FORWARDED_PREFIX' => '/rss',
+			]);
+			self::assertSame('/rss', Minz_Request::applicationPath());
+			self::assertSame('https://a.example/rss/i/',
+				Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', true));
+		} finally {
+			putenv('FRESHRSS_PATH_PREFIX');
+		}
+	}
+
+	public static function testConfiguredRootPrefixMeansNoSubDirectory(): void {
+		putenv('FRESHRSS_PATH_PREFIX=/');
+		try {
+			self::given(['base_url' => ''], [
+				'SCRIPT_NAME' => '/i/index.php',
+				'REQUEST_URI' => '/i/?c=index&a=index',
+				'HTTP_X_FORWARDED_HOST' => 'a.example',
+				'HTTP_X_FORWARDED_PROTO' => 'https',
+			]);
+			self::assertSame('', Minz_Request::applicationPath());
+			self::assertSame('https://a.example/i/',
+				Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', true));
+		} finally {
+			putenv('FRESHRSS_PATH_PREFIX');
+		}
+	}
+
+	public static function testRootModeAtTheDomainRootHasNoLeadingSlashProblem(): void {
+		self::given(['base_url' => ''], [
+			'SCRIPT_NAME' => '/i/index.php',
+			'REQUEST_URI' => '/i/',
+			'HTTP_X_FORWARDED_HOST' => 'a.example',
+			'HTTP_X_FORWARDED_PROTO' => 'https',
+		]);
+		self::assertSame('/i/', Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', 'root'));
+	}
+
+	public static function testRootModeWithAPinnedBaseUrl(): void {
+		self::given(['base_url' => 'https://pinned.example/rss'], self::subDirectoryRequest('b.example'));
+		// A full base URL pins the host, even though the request came in on another domain.
+		self::assertSame('/rss/i/',
+			Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', 'root'));
+	}
+
+	// -- absolute mode ------------------------------------------------------------------------
+
+	public static function testAbsoluteModeFollowsTheRequestHost(): void {
+		self::given(['base_url' => '/rss'], self::subDirectoryRequest('a.example'));
+		self::assertSame('https://a.example/rss/i/',
+			Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', true));
+		self::given(['base_url' => '/rss'], self::subDirectoryRequest('cn.example.org'));
+		self::assertSame('https://cn.example.org/rss/i/',
+			Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', true));
+	}
+
+	public static function testAbsoluteModeOnAStaticPath(): void {
+		self::given(['base_url' => '/rss'], self::subDirectoryRequest());
+		// This is what a mobile client is handed in the API page.
+		self::assertSame('https://a.example/rss/api/greader.php', Minz_Url::display('/api/greader.php', 'html', true));
+	}
+
+	public static function testAbsoluteModeHonoursAPinnedBaseUrl(): void {
+		self::given(['base_url' => 'https://pinned.example/rss'], self::subDirectoryRequest('b.example'));
+		self::assertSame('https://pinned.example/rss/api/greader.php',
+			Minz_Url::display('/api/greader.php', 'html', true));
+	}
+
+	// -- reverse proxy stripping the prefix --------------------------------------------------
+
+	public static function testAbsoluteModeWithAStrippingProxy(): void {
+		self::given(['base_url' => '/rss'], [
+			'SCRIPT_NAME' => '/i/index.php',
+			'REQUEST_URI' => '/i/',
+			'HTTP_X_FORWARDED_HOST' => 'a.example',
+			'HTTP_X_FORWARDED_PROTO' => 'https',
+			'HTTP_X_FORWARDED_PREFIX' => '/rss',
+		]);
+		self::assertSame('https://a.example/rss/i/',
+			Minz_Url::display(['c' => 'index', 'a' => 'index'], 'html', true));
+		self::assertSame('https://a.example/rss/api/greader.php',
+			Minz_Url::display('/api/greader.php', 'html', true));
+	}
+
+	// -- encoding -----------------------------------------------------------------------------
+
+	public static function testHtmlEncodingUsesAmpersandEntity(): void {
+		self::given(['base_url' => '/rss'], self::subDirectoryRequest());
+		$url = Minz_Url::display(
+			['c' => 'index', 'a' => 'normal', 'params' => ['search' => 'a b', 'state' => 2]],
+			'html',
+			'root'
+		);
+		self::assertSame('/rss/i/?a=normal&amp;search=a+b&amp;state=2', $url);
+
+		// A non-default controller is part of the query string.
+		self::assertSame('/rss/i/?c=configure&amp;a=system',
+			Minz_Url::display(['c' => 'configure', 'a' => 'system'], 'html', 'root'));
+	}
+
