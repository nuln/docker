diff --git a/p/scripts/login-watchdog.js b/p/scripts/login-watchdog.js
new file mode 100644
index 000000000..ea5439524
--- /dev/null
+++ b/p/scripts/login-watchdog.js
@@ -0,0 +1,79 @@
+// Watchdog for the login form.
+//
+// The submit button ships disabled and is enabled only by p/scripts/extra.js, once main.js has
+// published `window.context` and bcrypt.js has loaded. Should any of those three fail to arrive —
+// filtered by a Content-Security-Policy allowlist, blocked by an extension, a 404 from a partial
+// deployment, a proxy that drops some requests — the form becomes permanently unusable and says
+// nothing at all: the page renders, the button does nothing, and no request is ever sent.
+//
+// This script reports that instead of leaving the operator guessing, and reloads once because a
+// dropped request is usually transient. The reload is remembered in sessionStorage so it can never
+// become a loop.
+//
+// It is a separate file rather than inline because FreshRSS sends `default-src 'self'`, which
+// forbids inline script. It therefore cannot help when *every* sub-resource stalls; in that case
+// the page arrives unstyled, which is itself the visible symptom.
+'use strict';
+
+(function () {
+	const RELOAD_FLAG = 'freshrss_login_reloaded';
+	const DEADLINE_MS = 15000;
+	const POLL_MS = 500;
+
+	function button() {
+		return document.getElementById('loginButton');
+	}
+
+	function report() {
+		const btn = button();
+		if (!btn || !btn.parentNode) {
+			return;
+		}
+		const note = document.createElement('p');
+		note.className = 'alert alert-error';
+		note.id = 'loginWatchdogWarning';
+		note.textContent =
+			'The scripts this login form needs did not load, so it cannot be used. '
+			+ 'Check that scripts/main.js, scripts/extra.js and scripts/vendor/bcrypt.js are '
+			+ 'reachable, then reload this page.';
+		btn.parentNode.appendChild(note);
+	}
+
+	function shouldReload() {
+		try {
+			if (sessionStorage.getItem(RELOAD_FLAG) !== null) {
+				return false;
+			}
+			sessionStorage.setItem(RELOAD_FLAG, '1');
+			return true;
+		} catch (e) {
+			return true;	// Storage unavailable: better to reload than to stay stuck.
+		}
+	}
+
+	function watch() {
+		const started = Date.now();
+		const poll = setInterval(function () {
+			const btn = button();
+			if (btn && !btn.disabled) {
+				clearInterval(poll);
+				return;
+			}
+			if (Date.now() - started < DEADLINE_MS) {
+				return;
+			}
+			clearInterval(poll);
+			if (shouldReload()) {
+				location.reload();
+				return;
+			}
+			report();
+		}, POLL_MS);
+	}
+
+	if (document.readyState === 'loading') {
+		document.addEventListener('DOMContentLoaded', watch);
+	} else {
+		watch();
+	}
+}());
