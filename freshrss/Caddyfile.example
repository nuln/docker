# Caddy reverse proxy for FreshRSS served from a sub-directory, reachable through several domains.
#
# The path MUST reach Apache unchanged. Do NOT use `handle_path` / `uri strip_prefix` /
# `strip_prefix` here: mod_auth_openidc compares OIDCRedirectURI against the path Apache itself
# serves, so a proxy that strips the prefix makes OIDC impossible, and FreshRSS cannot recover
# the prefix for cookie paths and generated links. The container serves the prefix through an
# Apache `Alias` (see entrypoint.sh), so nothing is lost by not stripping — note `handle /rss/*`
# below, which preserves the path, as opposed to `handle_path /rss/*`, which would remove it.
#
# Replace `a.example` / `b.example` with your own domains, and make sure `FRESHRSS_PATH_PREFIX`
# on the FreshRSS container matches the prefix used below (/rss here).

(common) {
	encode zstd gzip

	# `handle`, not `handle_path`: the request path arrives at Apache as /rss/… unchanged.
	handle /rss/* {
		# Overwrite the forwarding headers, so a client cannot spoof them. Caddy already
		# replaces these rather than passing a client's value through; stating them here
		# documents the guarantee that FreshRSS and mod_auth_openidc rely on for building
		# absolute URLs and matching the OIDC callback.
		reverse_proxy freshrss:80 {
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Port {server_port}

			# --- keeping Cloudflare Browser Insights (optional) --------------------------
			# FreshRSS sends `Content-Security-Policy: default-src 'self'`, hard-coded in
			# lib/Minz/ActionController.php with no configuration key for `default-src`. That
			# policy blocks the `static.cloudflareinsights.com/beacon.min.js` that Cloudflare
			# injects at the edge, so Browser Insights never collects anything and the console
			# fills with violations.
			#
			# PREFER the environment: FRESHRSS_CSP_SCRIPT_SRC sets `script-src` inside the
			# container and needs nothing here. Use the line below only if you would rather keep
			# the policy at the edge.
			#
			# It REPLACES the header rather than adding to it, and that is required: several CSP
			# headers are enforced as their intersection, i.e. the most restrictive of them, so
			# appending a permissive `script-src` alongside the original policy would relax
			# nothing at all. `script-src` takes precedence over `default-src` for scripts only,
			# so every other directive still falls back to `default-src 'self'` and the policy
			# keeps doing its job.
			#
			# Sources must name a scheme and, when it is not the default for that scheme, the
			# port: CSP matches host *and* port exactly, so `https://static.cloudflareinsights.com`
			# permits that origin on 443 and nothing else. The beacon reports to /cdn-cgi/rum on
			# the same origin, which `default-src 'self'` already covers.
			# header_down Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; frame-ancestors 'none'"
		}
	}

	# A bare `/rss` has to reach `/rss/`, which is the FreshRSS entry point.
	redir /rss /rss/ 308

	# This domain serves FreshRSS under /rss only. Drop this line to let everything else on the
	# domain fall through to the site block below, e.g. to serve a static site at the root.
	respond 404
}

a.example {
	import common
}

b.example {
	import common
}

# Add as many domains as you like — a single container, a single configuration file.
# cn.example.org {
# 	import common
# }
