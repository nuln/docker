# Copy to `.env` and adjust. Every value here is optional: `docker compose up -d` works without a
# `.env` file at all, using the defaults shown below.

# --- image ------------------------------------------------------------------------------------
# Published tags: the upstream FreshRSS version the patch is based on, plus `latest`.
FRESHRSS_IMAGE=ghcr.io/nuln/freshrss:1.30.0

# --- how the instance is reached ---------------------------------------------------------------
# Host interface and port to publish. Loopback by default: the image speaks plain HTTP, so anything
# exposed beyond localhost should sit behind a reverse proxy that terminates TLS.
FRESHRSS_BIND=127.0.0.1
FRESHRSS_PORT=8080

# Public sub-directory. Must be identical on every domain that reaches this instance, because the
# OIDC callback and the session cookie path are derived from it. Empty = serve at the domain root.
FRESHRSS_PATH_PREFIX=/rss

# Pin a single domain instead of following the request. Leave empty for multi-domain.
# FRESHRSS_BASE_URL=https://a.example/rss

# Required only for WebSub; point it at ONE domain.
# FRESHRSS_WEBSUB_BASE_URL=https://rss.example.net/rss

# --- administrator account ---------------------------------------------------------------------
ADMIN_USER=alice
ADMIN_PASSWORD=change-me-now
FRESH_TITLE=FreshRSS

# --- misc -------------------------------------------------------------------------------------
TZ=Etc/UTC

# Feed refresh schedule. This is a WHOLE crontab expression, not just the minutes, despite the
# variable name: every 30 minutes is `*/30 * * * *`, not `*/30`. A shorter value is completed with
# `* * * *`, so `*/30` works too, but writing it out is clearer.
CRON_MIN=7,37 * * * *

# Only when a reverse proxy forwards the client address and FreshRSS must trust it. Use the proxy's
# real subnet, never 0.0.0.0/0.
# TRUSTED_PROXY=172.16.0.1/12

# --- OIDC (all or nothing) ---------------------------------------------------------------------
# OIDC_ENABLED=1
# OIDC_PROVIDER_METADATA_URL=https://idp.example/.well-known/openid-configuration
# OIDC_CLIENT_ID=freshrss
# OIDC_CLIENT_SECRET=
# OIDC_CLIENT_CRYPTO_KEY=0123456789abcdef0123456789abcdef
# OIDC_SCOPES=openid profile