# OCD 镜像（钉版，非 latest；发布新版本时手动升级标签）
OCD_IMAGE=ghcr.io/nuln/ocd:0.2.1

# 时区
TZ=Asia/Shanghai

# 容器资源限制
MEM_LIMIT=1024m
CPU_LIMIT=2

# 监听地址（容器内部绑定 0.0.0.0）
OCD_PUBLIC_BIND=0.0.0.0:8787
OCD_ADMIN_BIND=0.0.0.0:18787

# 管理与部署 Token（可选；留空时将在容器首次启动时自动随机生成并保存在 data/instances/default/data/keys/ 中）
# OCD_ADMIN_TOKEN=your-admin-token
# OCD_DEPLOYER_TOKEN=your-deployer-token
# OCD_READ_ONLY_TOKEN=your-read-only-token
