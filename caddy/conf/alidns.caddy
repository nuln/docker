# 阿里云 DNS-01 证书配置（独立可用）
# 单独部署：caddy run --config alidns.caddy
# 证书申请走阿里云 DNS 验证，不依赖 80 端口，支持通配符
# ALIDNS_AK / ALIDNS_SK 通过环境变量注入（运行期，不写盘）
{
	storage file_system {
		root /certs
	}
	email admin@example.com
	acme_dns alidns {
		access_key_id {env.ALIDNS_AK}
		access_key_secret {env.ALIDNS_SK}
		region_id cn-hangzhou
	}
}

example.com, www.example.com {
	respond "alidns DNS-01 TLS example" 200
}
