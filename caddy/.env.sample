# Caddy 镜像（钉版，非 latest；发布新版本时手动升级标签）
# :latest = 精简版（Dockerfile），:full = 完整版（Dockerfile.full，额外含 webdav/exec/webhook）
CADDY_IMAGE=ghcr.io/nuln/caddy:2.11.4

# 时区
TZ=Asia/Shanghai

# 弱机资源限制（参考 opencode 子项目约定）
MEM_LIMIT=512m
CPU_LIMIT=1

# Cloudflare DNS-01 验证 API Token（申请证书用，仅 Zone:DNS 编辑权限）
# 不填则回退到 HTTP-01 验证（需 80 端口可被公网访问）
CF_DNS_API_TOKEN=

# 阿里云 DNS-01 验证凭据（可选，用于 conf/alidns.caddy 示例）
ALIDNS_AK=
ALIDNS_SK=
