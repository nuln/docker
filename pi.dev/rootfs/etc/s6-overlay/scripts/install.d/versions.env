# =============================================================================
# versions.env — single source of truth for every pinned version installed by
# this image. Sourced by install.sh (installs) and setup.sh (bake). None of the
# values below may be "latest" — bump deliberately for reproducible builds.
#
# The Dockerfile ARGs (PI_VERSION / WRANGLER_VERSION / GH_VERSION / S6_OVERLAY_VERSION)
# override the matching entries here at bake time via the environment; the `:-
# default` form keeps an already-set env var (i.e. build-arg) winning.
# =============================================================================

# ---- base tools baked into the image layer (Dockerfile-ARG-overridable) ----
PI_VERSION="${PI_VERSION:-0.84.1}"
S6_OVERLAY_VERSION="${S6_OVERLAY_VERSION:-3.2.0.0}"
WRANGLER_VERSION="${WRANGLER_VERSION:-4.120.0}"
GH_VERSION="${GH_VERSION:-v2.97.0}"
REMOTE_PI_VERSION="${REMOTE_PI_VERSION:-0.5.5}"

# ---- on-demand language toolchains (install.d/*) ----
GO_VERSION="${GO_VERSION:-1.26.5}"
RUST_VERSION="${RUST_VERSION:-1.97.1}"
JAVA_VERSION="${JAVA_VERSION:-26}"
BUN_VERSION="${BUN_VERSION:-1.3.14}"
TYPESCRIPT_VERSION="${TYPESCRIPT_VERSION:-7.0.2}"
SCALA_CLI_VERSION="${SCALA_CLI_VERSION:-1.16.0}"
KOTLIN_VERSION="${KOTLIN_VERSION:-2.4.10}"
PHP_VERSION="${PHP_VERSION:-8.5.9}"
LUA_VERSION="${LUA_VERSION:-5.4.7}"

# ---- db / storage clients ----
MC_RELEASE="${MC_RELEASE:-RELEASE.2025-08-13T08-35-41Z}"

# ---- shell layer (oh-my-zsh + plugins) ----
# oh-my-zsh has no tags (rolling release); pin the master commit instead.
OMZ_COMMIT="${OMZ_COMMIT:-99aaf58d007f1378d1e0609bcd9baf8abbbaf327}"
ZSH_SYNTAX_VERSION="${ZSH_SYNTAX_VERSION:-0.8.0}"
ZSH_AUTOSUGGEST_VERSION="${ZSH_AUTOSUGGEST_VERSION:-0.7.1}"