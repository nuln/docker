{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": false,
  "toolInputPreviewMaxLength": 400,
  "toolTextSummaryMaxLength": 120,
  "piInfrastructureReadPaths": [
    "/root/.pi/agent/**",
    "/home/pi/.pi/agent/**"
  ],
  "authorizerChain": [],
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.git-credentials": "deny",
      "*.jks": "deny",
      "*.key": "deny",
      "*.npmrc*": "deny",
      "*.p12": "deny",
      "*.pem": "deny",
      "*.pfx": "deny",
      "*.ppk": "deny",
      "id_dsa*": "deny",
      "id_ecdsa*": "deny",
      "id_ed25519*": "deny",
      "id_rsa*": "deny",
      "~/*auth.json": "deny",
      "~/*credentials*": "deny",
      "~/*secret*": "deny",
      "~/*token*": "deny",
      "~/.authinfo": "deny",
      "~/.aws/*": "deny",
      "~/.azure/*": "deny",
      "~/.cloudflared/*": "deny",
      "~/.config/PowerShell/PSReadLine/ConsoleHost_history.txt": "deny",
      "~/.config/aws/*": "deny",
      "~/.config/azure/*": "deny",
      "~/.config/doctl/*": "deny",
      "~/.config/evolution/*": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.config/gh/*": "deny",
      "~/.config/glab-cli/*": "deny",
      "~/.config/heroku/*": "deny",
      "~/.config/hexchat/*": "deny",
      "~/.config/irssi/*": "deny",
      "~/.config/netlify/*": "deny",
      "~/.config/oci/*": "deny",
      "~/.config/octo/*": "deny",
      "~/.config/ovh/*": "deny",
      "~/.config/pip/pip.conf": "deny",
      "~/.config/polkitd/*": "deny",
      "~/.config/profiles/*": "deny",
      "~/.config/pypoetry/auth.toml": "deny",
      "~/.config/rclone/azure.ini": "deny",
      "~/.config/rclone/rclone.conf": "deny",
      "~/.config/tailscale/*": "deny",
      "~/.config/uv/uv.toml": "deny",
      "~/.config/vercel/*": "deny",
      "~/.config/yarn/*": "deny",
      "~/.docker/config.json": "deny",
      "~/.fastlane/*": "deny",
      "~/.gitconfig": "deny",
      "~/.gnupg/*": "deny",
      "~/.gradle.properties": "deny",
      "~/.gradle/gradle.properties": "deny",
      "~/.kube/*": "deny",
      "~/.kubernetes/*": "deny",
      "~/.local/share/com.vercel.cli/*": "deny",
      "~/.local/share/keyrings/*": "deny",
      "~/.local/share/password-store/*": "deny",
      "~/.local/share/tailscale/*": "deny",
      "~/.m2/settings.xml": "deny",
      "~/.my.cnf": "deny",
      "~/.netrc": "deny",
      "~/.netrc.d/*": "deny",
      "~/.oci/*": "deny",
      "~/.ovh.conf": "deny",
      "~/.password-store/*": "deny",
      "~/.pgpass": "deny",
      "~/.pypirc": "deny",
      "~/.s3cfg": "deny",
      "~/.snapcraft/*": "deny",
      "~/.ssh/*": "deny",
      "~/.ssh_keys/*": "deny",
      "~/.stack/*": "deny",
      "~/.terraform.d/*": "deny",
      "~/.terraformrc": "deny",
      "~/.thunderbird/*": "deny",
      "~/.ts.config": "deny",
      "~/.twilio/*": "deny",
      "~/.wrangler/*": "deny",
      "~/.yarnrc": "deny",
      "~/.yarnrc.yml": "deny",
      "~/id_ecdsa": "deny",
      "~/id_ed25519": "deny",
      "~/id_rsa": "deny"
    },
    "bash": {
      "*": "allow"
    },
    "external_directory": {
      "*": "allow"
    }
  }
}
