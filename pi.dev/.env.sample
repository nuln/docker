TZ=Asia/Shanghai
# Container image (pinned, not latest; update deliberately to a new release)
PI_IMAGE=ghcr.io/nuln/pi.dev:0.84.1

# --- permission policy ------------------------------------------------
# Empty (default) = do not seed; pi-permission-system uses its own built-in behaviour.
# Set PI_PERMISSION_SYSTEM_POLICY to pick a baked policy on FIRST boot:
#   allow | ask | deny | default | hardened
# (hardened = original 92-rule policy; default = blend safe/risky/credential paths)
# Existing user config always wins. Requires re-creating the container.
# PI_PERMISSION_SYSTEM_POLICY=

# --- curated skills ------------------------------------------------
# 33 baked skills live in the image at /etc/s6-overlay/plugins/skills but are
# NOT loaded by default. On FIRST boot wire-plugins copies the selected skills
# into ~/.agents/skills (pi's native global skills dir):
#   PI_SKILLS=true   -> copy ALL 33
#   PI_SKILLS=a,b,c  -> whitelist only (names = skill dirs under plugins/skills;
#                       unknown names are skipped with a warning)
#   false/empty      -> not loaded
# PI_SKILLS=true
# PI_SKILLS=tdd,browser,research
# Web UI self-healing watchdog poll interval (seconds)
PI_WATCHDOG_INTERVAL=30
# consecutive failed restarts before the watchdog backs off (crash-loop guard)
PI_WATCHDOG_MAX_FAILURES=3
# Mounted dir (./data/creds -> /home/pi/.creds). On every boot wire-plugins symlinks
# ALL CLI login credentials here so they survive `docker compose up` recreate:
#   .config dirs (gh/gcloud/aws/azure/uv/helm/rclone/wrangler...), .ssh, .aws, .azure,
#   .docker, .kube, flat dotfiles (.gitconfig/.git-credentials/.netrc/.npmrc/.pypirc/
#   .bunfig.toml/.gemrc), and .cargo/credentials.toml / .terraform.d/credentials.tfrc.json.
# PI_CREDS_DIR=/home/pi/.creds; add more via PI_CRED_EXTRA. Empty = not wired.
PI_CREDS_DIR=/home/pi/.creds
# Additional ~-relative credential paths to persist (comma separated, dir or file).
# Example: .claude,.cursor,.config/raycast,.config/anycli
# PI_CRED_EXTRA=.claude,.config/anycli

# --- outbound proxy (whole container). Fill to route egress through a proxy;
# NO_PROXY keeps LAN/fnOS on direct connection. Blank = no proxy. ---
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1,*.local,192.168.0.0/16

# --- opencode provider auto-config ----------------------------------------
# Set OPENCODE_API_KEY and the baked provider templates are applied on every
# boot to ~/.pi/agent/models.json + auth.json (no other env vars needed):
#   * opencode+free  (8 free models)                  always configured
#   * opencode+go    (7 paid Go models)               only when the key has an
#     active Go plan (detected automatically by a probe; no manual toggle)
#   * First boot / fresh mount -> full rebuild; later boots -> append only,
#     existing configs are kept (a newly detected Go config becomes
#     "opencode+go-2" if "opencode+go" already exists, nothing is overwritten)
# Manual re-apply any time:
#   docker compose exec pi install.sh providers [auto|--go|--no|status]
# OPENCODE_API_KEY=

# --- resource limits for a weak host (conservative defaults for an Intel J3455) ---
# cargo parallel build jobs: J3455 uses 1, N5105 can use 2
CARGO_BUILD_JOBS=1
# Go build/run parallelism
GOMAXPROCS=2
# make parallelism (C/Python source builds, etc.)
MAKEFLAGS=-j2
# container memory limit (e.g. 4g / 6g)
MEM_LIMIT=4g
# container CPU cores (J3455 can use 1, N5105 2)
CPU_LIMIT=2

# --- plugin service ports (services bind 127.0.0.1 by default; map only when external access is needed) ---
# Auto-start the Web UI daemon on container start (pi --web --lan, http://<host>:3141). 0 disables.
PI_AUTOSTART_WEB=1
# Web UI (pi-web-chat, pi --web)
PI_WEB_PORT=3141
# IM gateway (@gamalan/pi-gateway); only when using gateway; @llblab/pi-telegram long polling needs none
PI_GATEWAY_PORT=3847
# Feishu/Lark card callback (pi-feishu-lark)
PI_FEISHU_PORT=3001
# remote-pi relay (enable when self-hosting, adjust as needed)
PI_RELAY_PORT=3030
