# Timezone
TZ=Asia/Shanghai
# Container image (pin deliberately; PI_IMAGE=pi.dev:<ver> to use a local build)
PI_IMAGE=ghcr.io/nuln/pi.dev:0.84.1

# --- features (empty/omitted = built-in default; see README) ---
# First-boot permission policy: allow | ask | deny | default | hardened
# PI_PERMISSION_SYSTEM_POLICY=
# Load baked skills: true = all 33, a,b,c = whitelist, false/empty = none
# PI_SKILLS=true
# Auto-start the Web UI daemon on container start (pi --web --lan)
PI_AUTOSTART_WEB=true
# Credential persistence mount (whitelisted CLI logins survive recreate)
PI_CREDS_DIR=/home/pi/.creds

# --- opencode provider auto-config (set to enable) ---
# OPENCODE_API_KEY=

# --- outbound proxy for the whole container (blank = no proxy) ---
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1,*.local,192.168.0.0/16

# --- resource limits ---
# Container memory / CPU caps (conservative defaults for a weak host)
MEM_LIMIT=4g
CPU_LIMIT=2

# --- host ports (map only when external access is needed) ---
# Web UI
PI_WEB_PORT=3141
# IM gateway (@gamalan/pi-gateway)
PI_GATEWAY_PORT=3847
# Feishu/Lark card callback
PI_FEISHU_PORT=3001
# remote-pi relay (enable when self-hosting)
PI_RELAY_PORT=3030
