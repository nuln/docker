# iCloud 镜像（钉版，非 latest；发布新版本时手动升级标签）
ICLOUD_IMAGE=ghcr.io/nuln/icloud:1.28.0

# 运行用户（保持与镜像内 abc 用户 uid/gid 一致，避免权限错乱）
PUID=1000
PGID=1000

# 时区
TZ=Asia/Shanghai

# ⚠️ 加密口令：每次启动都必须提供【同一个】KEYRING_PASSPHRASE
# 忘记就只能删 ./config/python_keyring/ 重新手动登录。
# 用 openssl rand -base64 24 生成一个强口令填这里。
KEYRING_PASSPHRASE=

# 弱机资源限制
MEM_LIMIT=1g
CPU_LIMIT=2
